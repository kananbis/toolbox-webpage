---
import type { Lang } from "@/i18n/translations";
import { CODEC_MANIFEST } from "@/utils/image-converter-codecs";
import { IMAGE_METADATA_CODEC_MANIFEST } from "@/utils/image-metadata-codecs";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = lang === "ko" ? {
  file: "이미지 파일", help: "JPG, HEIC, HEIF 사진을 선택하거나 이 영역에 끌어다 놓으세요.",
  view: "정보 보기", edit: "정보 수정", remove: "정보 제거", preview: "미리보기", fileInfo: "파일 정보",
  noFile: "이미지를 선택하면 메타데이터를 표시합니다.", local: "선택한 이미지와 메타데이터는 서버로 전송되지 않고 현재 브라우저 안에서 처리됩니다.",
  description: "이미지 설명", artist: "작성자", copyright: "저작권", software: "소프트웨어", date: "촬영 날짜/시간", make: "제조사", model: "모델", orientation: "방향 정보", latitude: "위도", longitude: "경도", altitude: "고도",
  basic: "기본 정보", camera: "카메라 정보", location: "위치 정보", advanced: "고급 촬영 정보", changes: "변경 사항", resetChanges: "변경 초기화", downloadEdited: "수정된 이미지 다운로드",
  gpsOnly: "GPS 위치 정보", dates: "촬영 날짜/시간", cameraInfo: "카메라 정보", advancedCapture: "고급 촬영 정보", credits: "작성자/저작권", descriptionSoftware: "설명/소프트웨어", xmp: "XMP 및 텍스트 정보", all: "모든 제거 가능한 메타데이터", downloadCleaned: "선택 정보 제거 후 다운로드", downloadRemoved: "모든 메타데이터 제거 후 다운로드",
  unsupportedEdit: "이 형식은 현재 안전하게 검증된 메타데이터 수정 기능이 없습니다.", heicLoading: "HEIC/HEIF 미리보기를 준비하는 중입니다. 이미지 파일은 외부로 전송되지 않습니다.", heicReadOnly: "HEIC/HEIF는 기존 EXIF 항목만 수정하거나 제거할 수 있습니다. 새 메타데이터 추가와 XMP 수정은 지원하지 않습니다.",
  noMetadata: "표시할 메타데이터가 없습니다.", changed: "변경됨", noChanges: "변경 사항이 없습니다.", invalidGps: "GPS 값이 올바른 범위를 벗어났습니다.", invalidDate: "촬영 날짜/시간 형식이 올바르지 않습니다.", failed: "이미지 메타데이터를 처리할 수 없습니다.", result: "처리 결과", pixelPreserved: "이미지 압축 데이터: 유지됨", metadataRewritten: "메타데이터 영역만 변경했습니다.",
  original: "원본", output: "결과", format: "형식", dimensions: "이미지 크기", size: "파일 용량", metadata: "메타데이터", removeGps: "GPS 정보 제거", orientationHelp: "방향 정보만 변경하며 이미지 픽셀 자체는 회전하지 않습니다.",
} : {
  file: "Image file", help: "Choose a JPG, HEIC, or HEIF photo, or drag it here.",
  view: "View metadata", edit: "Edit metadata", remove: "Remove metadata", preview: "Preview", fileInfo: "File information",
  noFile: "Choose an image to display its metadata.", local: "Your image and metadata stay in the current browser and are not sent to a server.",
  description: "Image description", artist: "Artist", copyright: "Copyright", software: "Software", date: "Date and time taken", make: "Make", model: "Model", orientation: "Orientation", latitude: "Latitude", longitude: "Longitude", altitude: "Altitude",
  basic: "Basic information", camera: "Camera information", location: "Location", advanced: "Advanced capture information", changes: "Changes", resetChanges: "Reset changes", downloadEdited: "Download edited image",
  gpsOnly: "GPS location", dates: "Date and time taken", cameraInfo: "Camera information", advancedCapture: "Advanced capture information", credits: "Author and copyright", descriptionSoftware: "Description and software", xmp: "XMP and text metadata", all: "All removable metadata", downloadCleaned: "Remove selected metadata and download", downloadRemoved: "Remove all metadata and download",
  unsupportedEdit: "Safe metadata editing has not been verified for this format.", heicLoading: "Preparing the HEIC/HEIF preview. Your image file is not sent externally.", heicReadOnly: "HEIC/HEIF can edit or remove existing EXIF entries only. Adding new metadata and editing XMP are not supported.",
  noMetadata: "No metadata is available to display.", changed: "Changed", noChanges: "There are no changes.", invalidGps: "GPS values are outside the valid range.", invalidDate: "The date and time value is invalid.", failed: "This image metadata could not be processed.", result: "Result", pixelPreserved: "Compressed image data: preserved", metadataRewritten: "Only metadata containers were changed.",
  original: "Original", output: "Output", format: "Format", dimensions: "Image dimensions", size: "File size", metadata: "Metadata", removeGps: "Remove GPS", orientationHelp: "This only changes the orientation metadata; image pixels are not rotated.",
};
---

<div class="grid gap-4" data-image-metadata-editor data-lang={lang}>
  <label class="grid cursor-pointer gap-2 rounded-md border border-dashed border-line bg-panel p-4 text-sm hover:border-brand" data-drop-zone>
    <span class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1"><span class="font-semibold text-ink">{t.file}</span><span class="text-right text-slate-600">{t.help}</span></span>
    <input data-file type="file" accept="image/jpeg,image/heic,image/heif,.jpg,.jpeg,.heic,.heif" />
  </label>

  <section class="hidden grid gap-3" data-workspace>
    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(280px,.65fr)]">
      <div class="grid gap-2"><p class="text-sm font-semibold text-slate-600">{t.preview}</p><div class="checkerboard flex h-[260px] items-center justify-center overflow-hidden rounded-md border border-line bg-slate-50 sm:h-[360px]"><img data-preview class="hidden h-full w-full object-contain" alt="" /></div></div>
      <div class="grid content-start gap-2"><p class="text-sm font-semibold text-slate-600">{t.fileInfo}</p><dl class="result-box grid gap-1 text-sm" data-file-info></dl></div>
    </div>
    <div class="flex flex-wrap gap-2" role="tablist" aria-label={t.metadata}>
      <button class="btn-secondary" type="button" data-mode="view" aria-selected="true">{t.view}</button><button class="btn-secondary" type="button" data-mode="edit" aria-selected="false">{t.edit}</button><button class="btn-secondary" type="button" data-mode="remove" aria-selected="false">{t.remove}</button>
    </div>
    <p class="hidden text-sm text-amber-700" data-format-note role="alert"></p>
    <section data-panel="view" class="grid gap-4">
      <div class="grid gap-3 md:grid-cols-2" data-metadata-groups></div>
    </section>
    <section data-panel="edit" class="hidden grid gap-4">
      <div class="grid gap-4 md:grid-cols-2">
        <fieldset class="grid gap-3 rounded-md border border-line bg-slate-50 p-3"><legend class="px-1 text-sm font-semibold">{t.basic}</legend><label>{t.description}<input data-field="description" type="text" /></label><label>{t.artist}<input data-field="artist" type="text" /></label><label>{t.copyright}<input data-field="copyright" type="text" /></label><label>{t.software}<input data-field="software" type="text" /></label><label>{t.date}<input data-field="dateTimeOriginal" type="datetime-local" step="1" /></label></fieldset>
        <fieldset class="grid gap-3 rounded-md border border-line bg-slate-50 p-3"><legend class="px-1 text-sm font-semibold">{t.camera}</legend><label>{t.make}<input data-field="make" type="text" /></label><label>{t.model}<input data-field="model" type="text" /></label><label>{t.orientation}<select data-field="orientation"><option value="1">1 - Normal</option><option value="2">2</option><option value="3">3 - 180°</option><option value="4">4</option><option value="5">5</option><option value="6">6 - 90° CW</option><option value="7">7</option><option value="8">8 - 90° CCW</option></select></label><p class="text-xs text-slate-600">{t.orientationHelp}</p></fieldset>
      </div>
      <fieldset class="grid gap-3 rounded-md border border-line bg-slate-50 p-3"><legend class="px-1 text-sm font-semibold">{t.location}</legend><div class="grid gap-3 md:grid-cols-3"><label>{t.latitude}<input data-field="latitude" type="number" min="-90" max="90" step="any" /></label><label>{t.longitude}<input data-field="longitude" type="number" min="-180" max="180" step="any" /></label><label>{t.altitude}<input data-field="altitude" type="number" step="any" /></label></div><button class="btn-secondary w-fit" type="button" data-action="clear-gps">{t.removeGps}</button></fieldset>
      <div class="flex flex-wrap gap-2"><button class="btn-secondary" type="button" data-action="reset-changes">{t.resetChanges}</button><button class="btn-primary" type="button" data-action="download-edited">{t.downloadEdited}</button></div><p class="result-box text-sm" data-changes aria-live="polite"></p>
    </section>
    <section data-panel="remove" class="hidden grid gap-3">
      <fieldset class="rounded-md border border-line bg-slate-50 p-3">
        <legend class="px-1 text-sm font-semibold">{t.remove}</legend>
        <div class="grid gap-2 sm:grid-cols-2">
          <label class="flex min-h-11 items-center gap-3 rounded border border-transparent px-3 text-sm hover:border-line hover:bg-white"><input class="h-4 w-4 shrink-0" data-remove="gps" type="checkbox" />{t.gpsOnly}</label>
          <label class="flex min-h-11 items-center gap-3 rounded border border-transparent px-3 text-sm hover:border-line hover:bg-white"><input class="h-4 w-4 shrink-0" data-remove="dates" type="checkbox" />{t.dates}</label>
          <label class="flex min-h-11 items-center gap-3 rounded border border-transparent px-3 text-sm hover:border-line hover:bg-white"><input class="h-4 w-4 shrink-0" data-remove="camera" type="checkbox" />{t.cameraInfo}</label>
          <label class="flex min-h-11 items-center gap-3 rounded border border-transparent px-3 text-sm hover:border-line hover:bg-white"><input class="h-4 w-4 shrink-0" data-remove="advanced" type="checkbox" />{t.advancedCapture}</label>
          <label class="flex min-h-11 items-center gap-3 rounded border border-transparent px-3 text-sm hover:border-line hover:bg-white"><input class="h-4 w-4 shrink-0" data-remove="credits" type="checkbox" />{t.credits}</label>
          <label class="flex min-h-11 items-center gap-3 rounded border border-transparent px-3 text-sm hover:border-line hover:bg-white"><input class="h-4 w-4 shrink-0" data-remove="description" type="checkbox" />{t.descriptionSoftware}</label>
          <label class="flex min-h-11 items-center gap-3 rounded border border-transparent px-3 text-sm hover:border-line hover:bg-white sm:col-span-2"><input class="h-4 w-4 shrink-0" data-remove="xmp" type="checkbox" />{t.xmp}</label>
        </div>
      </fieldset>
      <div class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-line bg-white p-3">
        <button class="btn-secondary" type="button" data-action="download-cleaned">{t.downloadCleaned}</button>
        <button class="btn-primary" type="button" data-action="download-removed">{t.downloadRemoved}</button>
      </div>
    </section>
    <div><p class="text-sm font-semibold text-slate-600">{t.result}</p><pre class="result-box mt-2 whitespace-pre-wrap" data-result></pre></div>
  </section>
  <p class="result-box" data-empty>{t.noFile}</p>
</div>

<script is:inline set:html={`window.__MFW_METADATA_HEIF_CODEC__ = ${JSON.stringify(CODEC_MANIFEST.heif)}; window.__MFW_METADATA_EXIFR_CODEC__ = ${JSON.stringify(IMAGE_METADATA_CODEC_MANIFEST.exifr)}; window.__MFW_METADATA_PIEXIF_CODEC__ = ${JSON.stringify(IMAGE_METADATA_CODEC_MANIFEST.piexif)};`} />

<script>
  const metadataCodec = window.__MFW_METADATA_HEIF_CODEC__;
  const metadataExifCodec = window.__MFW_METADATA_EXIFR_CODEC__;
  const metadataPiexifCodec = window.__MFW_METADATA_PIEXIF_CODEC__;
  const text = (lang) => lang === "ko" ? { none: "없음", unsupported: "지원하지 않는 이미지 형식입니다.", loading: "HEIC/HEIF 미리보기를 준비하는 중입니다.", error: "이미지 메타데이터를 처리할 수 없습니다.", edited: "수정", cleaned: "선택 제거", removed: "전체 제거", preserved: "이미지 압축 데이터: 유지됨\n메타데이터 영역만 변경했습니다.", changed: "변경된 항목", noMetadata: "표시할 메타데이터가 없습니다." } : { none: "None", unsupported: "Unsupported image format.", loading: "Preparing HEIC/HEIF preview.", error: "This image metadata could not be processed.", edited: "Edited", cleaned: "Selected metadata removed", removed: "All removable metadata removed", preserved: "Compressed image data: preserved\nOnly metadata containers were changed.", changed: "Changed fields", noMetadata: "No metadata is available to display." };
  const read16 = (v, o, le) => v.getUint16(o, le);
  const read32 = (v, o, le) => v.getUint32(o, le);
  const ascii = (bytes) => new TextDecoder("latin1").decode(bytes);
  const utf8 = (bytes) => new TextDecoder().decode(bytes);
  const formatBytes = (n) => n < 1024 ? `${n} B` : n < 1048576 ? `${(n / 1024).toFixed(2)} KB` : `${(n / 1048576).toFixed(2)} MB`;
  const ext = (name) => name.replace(/.*\./, "").toLowerCase();
  const identify = (bytes, name, type) => {
    const b = new Uint8Array(bytes, 0, Math.min(bytes.byteLength, 32)); const h = ascii(b);
    if (b[0] === 0xff && b[1] === 0xd8) return "jpeg";
    if (h.startsWith("\x89PNG\r\n\x1a\n")) return "png";
    if (h.startsWith("RIFF") && h.slice(8, 12) === "WEBP") return "webp";
    if (h.slice(4, 16).match(/ftyp(heic|heix|hevc|hevx|heif|mif1)/)) return "heif";
    return type === "image/heic" || type === "image/heif" || ["heic", "heif"].includes(ext(name)) ? "heif" : "unknown";
  };
  const exifTagNames = { 0x010e: "description", 0x010f: "make", 0x0110: "model", 0x0112: "orientation", 0x0131: "software", 0x013b: "artist", 0x8298: "copyright", 0x8769: "exifOffset", 0x8825: "gpsOffset", 0x9003: "dateTimeOriginal", 0x9004: "dateTimeDigitized", 0x0132: "dateTimeModified", 0x829a: "exposureTime", 0x829d: "fNumber", 0x8827: "iso", 0x920a: "focalLength", 0xa434: "lensModel" };
  const typeBytes = { 1: 1, 2: 1, 3: 2, 4: 4, 5: 8, 7: 1, 9: 4, 10: 8 };
  const parseExif = (raw) => {
    const bytes = raw instanceof Uint8Array ? raw : new Uint8Array(raw); let start = 0;
    if (ascii(bytes.subarray(0, 6)) === "Exif\0\0") start = 6;
    if (bytes.length < start + 8 || !["II", "MM"].includes(ascii(bytes.subarray(start, start + 2)))) return {};
    const view = new DataView(bytes.buffer, bytes.byteOffset + start, bytes.byteLength - start); const le = ascii(bytes.subarray(start, start + 2)) === "II";
    if (read16(view, 2, le) !== 42) return {}; const out = {};
    const value = (type, count, offset) => { const total = (typeBytes[type] || 1) * count; const pos = total <= 4 ? offset + 8 : read32(view, offset + 8, le); if (pos < 0 || pos + total > view.byteLength) return undefined; const data = new Uint8Array(view.buffer, view.byteOffset + pos, total); if (type === 2) return utf8(data).replace(/\0+$/, ""); if (type === 3) return count === 1 ? read16(view, pos, le) : Array.from({ length: count }, (_, i) => read16(view, pos + i * 2, le)); if (type === 4) return read32(view, pos, le); if (type === 5 && count) { const values = Array.from({ length: count }, (_, i) => { const a = read32(view, pos + i * 8, le), b = read32(view, pos + i * 8 + 4, le); return b ? a / b : undefined; }); return count === 1 ? values[0] : values; } return undefined; };
    const visit = (offset, group) => { if (!offset || offset + 2 > view.byteLength) return; const count = read16(view, offset, le); for (let i = 0; i < count; i += 1) { const entry = offset + 2 + i * 12; if (entry + 12 > view.byteLength) break; const tag = read16(view, entry, le), type = read16(view, entry + 2, le), countValue = read32(view, entry + 4, le), name = exifTagNames[tag]; const result = value(type, countValue, entry); if (name === "exifOffset") visit(result, "exif"); else if (name === "gpsOffset") parseGps(result); else if (name && result !== undefined) out[name] = result; } };
    const parseGps = (offset) => { if (!offset || offset + 2 > view.byteLength) return; const count = read16(view, offset, le); const gps = {}; for (let i = 0; i < count; i += 1) { const entry = offset + 2 + i * 12; if (entry + 12 > view.byteLength) break; const tag = read16(view, entry, le), type = read16(view, entry + 2, le), n = read32(view, entry + 4, le), val = value(type, n, entry); gps[tag] = val; } const degree = (v) => Array.isArray(v) ? v[0] + v[1] / 60 + v[2] / 3600 : undefined; let lat = degree(gps[2]), lon = degree(gps[4]); if (gps[1] === "S") lat = -lat; if (gps[3] === "W") lon = -lon; if (Number.isFinite(lat)) out.latitude = lat; if (Number.isFinite(lon)) out.longitude = lon; if (Number.isFinite(gps[6])) out.altitude = gps[5] === 1 ? -gps[6] : gps[6]; };
    visit(read32(view, 4, le), "ifd0"); return out;
  };
  const jpegParts = (bytes) => { const parts = []; let pos = 2; while (pos + 4 <= bytes.length && bytes[pos] === 0xff) { const marker = bytes[pos + 1]; if (marker === 0xda || marker === 0xd9) { parts.push({ marker, raw: bytes.slice(pos) }); break; } const length = (bytes[pos + 2] << 8) | bytes[pos + 3]; if (length < 2 || pos + 2 + length > bytes.length) throw new Error("JPEG_INVALID"); parts.push({ marker, raw: bytes.slice(pos, pos + 2 + length), body: bytes.slice(pos + 4, pos + 2 + length) }); pos += 2 + length; } return parts; };
  const parseJpeg = (bytes) => { const parts = jpegParts(bytes); const metadata = parts.filter((part) => part.marker === 0xe1 && ascii(part.body.subarray(0, 6)) === "Exif\0\0").reduce((all, part) => ({ ...all, ...parseExif(part.body) }), {}); return { metadata, parts }; };
  const pngChunks = (bytes) => { const out = []; let pos = 8; while (pos + 12 <= bytes.length) { const length = new DataView(bytes.buffer, bytes.byteOffset + pos).getUint32(0); const end = pos + 12 + length; if (end > bytes.length) throw new Error("PNG_INVALID"); out.push({ type: ascii(bytes.subarray(pos + 4, pos + 8)), raw: bytes.slice(pos, end), data: bytes.slice(pos + 8, pos + 8 + length) }); pos = end; } return out; };
  const parsePng = (bytes) => { const chunks = pngChunks(bytes); const metadata = {}; for (const c of chunks) { if (c.type === "eXIf") Object.assign(metadata, parseExif(c.data)); if (c.type === "tEXt") { const i = c.data.indexOf(0); if (i > 0) { const k = ascii(c.data.subarray(0, i)).toLowerCase(); const v = utf8(c.data.subarray(i + 1)); if (k.includes("description")) metadata.description = v; if (k.includes("author") || k.includes("artist")) metadata.artist = v; if (k.includes("copyright")) metadata.copyright = v; if (k.includes("software")) metadata.software = v; } } } return { metadata, chunks }; };
  const webpChunks = (bytes) => { const out = []; let pos = 12; while (pos + 8 <= bytes.length) { const type = ascii(bytes.subarray(pos, pos + 4)); const len = new DataView(bytes.buffer, bytes.byteOffset + pos + 4, 4).getUint32(0, true); const end = pos + 8 + len; if (end > bytes.length) throw new Error("WEBP_INVALID"); out.push({ type, raw: bytes.slice(pos, end + (len % 2)), data: bytes.slice(pos + 8, end) }); pos = end + (len % 2); } return out; };
  const parseWebp = (bytes) => { const chunks = webpChunks(bytes); const exif = chunks.find((c) => c.type === "EXIF"); return { metadata: exif ? parseExif(exif.data) : {}, chunks }; };
  const crcTable = (() => { const table = new Uint32Array(256); for (let i = 0; i < 256; i++) { let c = i; for (let j = 0; j < 8; j++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1; table[i] = c >>> 0; } return table; })();
  const crc32 = (bytes) => { let c = 0xffffffff; for (const b of bytes) c = crcTable[(c ^ b) & 255] ^ (c >>> 8); return (c ^ 0xffffffff) >>> 0; };
  const join = (parts) => { const n = parts.reduce((sum, p) => sum + p.length, 0); const out = new Uint8Array(n); let at = 0; for (const p of parts) { out.set(p, at); at += p.length; } return out; };
  const pngChunk = (type, data) => { const typeBytes = new TextEncoder().encode(type); const out = new Uint8Array(12 + data.length); const view = new DataView(out.buffer); view.setUint32(0, data.length); out.set(typeBytes, 4); out.set(data, 8); view.setUint32(8 + data.length, crc32(join([typeBytes, data]))); return out; };
  const pngText = (key, value) => pngChunk("tEXt", join([new TextEncoder().encode(key), new Uint8Array([0]), new TextEncoder().encode(value)]));
  const xmpPacket = (meta) => `<?xpacket begin="﻿"?><x:xmpmeta xmlns:x="adobe:ns:meta/"><rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"><rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xmp="http://ns.adobe.com/xap/1.0/" xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/" dc:description="${escapeXml(meta.description || "")}" dc:creator="${escapeXml(meta.artist || "")}" dc:rights="${escapeXml(meta.copyright || "")}" xmp:CreatorTool="${escapeXml(meta.software || "")}" photoshop:DateCreated="${escapeXml(toIso(meta.dateTimeOriginal) || "")}"/></rdf:RDF></x:xmpmeta><?xpacket end="w"?>`;
  const escapeXml = (s) => String(s).replace(/[<>&"']/g, (c) => ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;", "'": "&apos;" })[c]);
  const toExifDate = (value) => value ? value.replace("T", " ").replace(/-/g, ":") : "";
  const toLocalDate = (value) => value && /^\d{4}:\d{2}:\d{2} \d{2}:\d{2}:\d{2}$/.test(value) ? value.replace(/^(.{4}):(.{2}):(.{2}) (.*)$/, "$1-$2-$3T$4") : "";
  const toIso = (value) => value ? `${value.replace("T", " ")}` : "";
