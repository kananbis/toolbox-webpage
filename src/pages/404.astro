---
import Layout from "@/components/Layout.astro";
---

<Layout
  title="Page Not Found - Toolbox"
  description="The requested Toolbox page could not be found."
  canonical="/404/"
  robots="noindex, follow"
>
  <section class="mx-auto max-w-2xl py-12 text-center">
    <p class="text-sm font-semibold text-brand">404</p>
    <h1 class="mt-3 text-3xl font-bold">Page Not Found</h1>
    <p class="mt-4 text-slate-700">The page may have moved, or the address may be incorrect.</p>
    <div class="mt-6 flex justify-center gap-3">
      <a class="rounded-md bg-brand px-4 py-2 font-semibold text-white no-underline" href="/ko/">한국어 도구 보기</a>
      <a class="rounded-md border border-line bg-white px-4 py-2 font-semibold text-ink no-underline" href="/en/">Browse English tools</a>
    </div>
  </section>
</Layout>
