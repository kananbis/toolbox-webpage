          state.panY = initialPanY + event.clientY - panStartY;
          updateMosaicViewport(root);
          return;
        }
        if (!isDragging || !startPoint) return;
        event.preventDefault();
        const point = pointOnCanvas(mosaicCanvas, event);
        if (activeMosaicMode === "brush") {
          drawMosaicBrushStroke(root, lastBrushPoint || point, point);
          lastBrushPoint = point;
          drawMosaicPreview(root);
          return;
        }
        const selection = {
          x: Math.min(startPoint.x, point.x),
          y: Math.min(startPoint.y, point.y),
          width: Math.abs(point.x - startPoint.x),
          height: Math.abs(point.y - startPoint.y),
        };
        setMosaicSelection(root, selection);
        drawMosaicPreview(root);
      });
      const stopMosaicDrag = async (event) => {
        if (isPanning) {
          event.preventDefault();
          isPanning = false;
          return;
        }
        if (!isDragging) return;
        event.preventDefault();
        isDragging = false;
        startPoint = null;
        lastBrushPoint = null;
        drawMosaicPreview(root);
        try {
          await refreshMosaicOutput(root);
        } catch (error) {
          root.querySelector("#result").textContent = error instanceof Error ? error.message : messages[root.dataset.lang || "ko"].checkInput;
        }
      };
      mosaicCanvas.addEventListener("pointerup", stopMosaicDrag);
      mosaicCanvas.addEventListener("pointercancel", stopMosaicDrag);
    }
    const colorCanvas = root.querySelector("#color-canvas");
    if (colorCanvas) {
      colorCanvas.addEventListener("pointermove", (event) => updateColorLoupe(root, event));
      colorCanvas.addEventListener("pointerleave", () => hideColorLoupe(root));
      colorCanvas.addEventListener("click", (event) => {
        pickCanvasColor(root, event).catch((error) => {
          root.querySelector("#result").textContent = error instanceof Error ? error.message : messages[root.dataset.lang || "ko"].checkInput;
        });
      });
    }
    syncDynamicInputs(root);
    initTimeZoneConverter(root);
    if (slug === "audio-cutter" || slug === "iphone-ringtone-maker") {
      initRingtonePointerEvents(root);
      let resizeTimer = 0;
      window.addEventListener("resize", () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => requestRingtoneDraw(root), 120);
      });
      updateRingtoneUi(root);
    }
    if (slug === "time-zone-converter") run(root);
    if (selectOnlyAutoRunSlugs.has(slug)) autoRun();
  });
</script>
