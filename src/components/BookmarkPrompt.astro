---
import type { Lang } from "@/i18n/translations";

type Props = { lang?: Lang };
const { lang = "ko" } = Astro.props;

const text = {
  ko: {
    title: "자주 쓴다면 즐겨찾기에 추가해두세요",
    description: "필요할 때 바로 다시 찾을 수 있도록 브라우저 즐겨찾기나 홈 화면에 추가할 수 있습니다.",
    open: "추가 방법 보기",
    close: "닫기",
    desktop: "데스크톱",
    mobile: "모바일",
    windows: "Windows / Chrome / Edge: Ctrl + D",
    mac: "Mac / Safari / Chrome: Command (⌘) + D",
    iphone: "iPhone Safari: 공유 버튼 → 즐겨찾기에 추가 또는 홈 화면에 추가",
    android: "Android Chrome: 메뉴 (⋮) → 홈 화면에 추가 또는 북마크 추가",
  },
  en: {
    title: "Use Toolbox often? Add it to your bookmarks.",
    description: "Save Toolbox to your browser bookmarks or home screen so you can open it quickly next time.",
    open: "How to bookmark",
    close: "Close",
    desktop: "Desktop",
    mobile: "Mobile",
    windows: "Windows / Chrome / Edge: Ctrl + D",
    mac: "Mac / Safari / Chrome: Command (⌘) + D",
    iphone: "iPhone Safari: Share → Add to Favorites or Add to Home Screen",
    android: "Android Chrome: Menu (⋮) → Add to Home screen or Bookmark",
  },
}[lang];
---

<section class="mt-6 rounded-md border border-line bg-panel/60 px-4 py-3" data-bookmark-prompt>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-base font-semibold">{text.title}</h2>
      <p class="mt-1 max-w-2xl text-sm leading-5 text-slate-600">{text.description}</p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-2">
      <button class="rounded-md border border-line bg-white px-3 py-1.5 text-xs font-semibold text-ink" type="button" data-bookmark-toggle aria-expanded="false">{text.open}</button>
      <button class="rounded-md border border-line bg-white px-3 py-1.5 text-xs font-semibold text-slate-600" type="button" data-bookmark-close>{text.close}</button>
    </div>
  </div>
  <div class="mt-3 hidden rounded-md border border-line bg-white p-3 text-sm leading-6 text-slate-700" data-bookmark-details>
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <p class="font-semibold text-ink">{text.desktop}</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>{text.windows}</li>
          <li>{text.mac}</li>
        </ul>
      </div>
      <div>
        <p class="font-semibold text-ink">{text.mobile}</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>{text.iphone}</li>
          <li>{text.android}</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const prompt = document.querySelector("[data-bookmark-prompt]");
  const details = prompt?.querySelector("[data-bookmark-details]");
  const toggle = prompt?.querySelector("[data-bookmark-toggle]");
  const closeButton = prompt?.querySelector("[data-bookmark-close]");
  const storageKey = "mfwtools_bookmark_prompt_hidden_until";
  const thirtyDaysMs = 30 * 24 * 60 * 60 * 1000;

  const safeGetHiddenUntil = () => {
    try {
      return Number(window.localStorage.getItem(storageKey) || "0");
    } catch {
      return 0;
    }
  };

  const safeSetHiddenUntil = () => {
    try {
      window.localStorage.setItem(storageKey, String(Date.now() + thirtyDaysMs));
    } catch {
      // Ignore storage errors so the prompt still works in restricted browsers.
    }
  };

  if (prompt && safeGetHiddenUntil() > Date.now()) {
    prompt.remove();
  }

  toggle?.addEventListener("click", () => {
    if (!details || !(toggle instanceof HTMLButtonElement)) return;
    const isHidden = details.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isHidden));
  });

  closeButton?.addEventListener("click", () => {
    safeSetHiddenUntil();
    prompt?.remove();
  });
</script>
