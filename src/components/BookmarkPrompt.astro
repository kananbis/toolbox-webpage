---
import type { Lang } from "@/i18n/translations";

type Props = { lang?: Lang };
const { lang = "ko" } = Astro.props;

const text = {
  ko: {
    title: "자주 사용하는 도구인가요? 즐겨찾기에 추가",
    desktop: "데스크톱",
    mobile: "모바일",
    windows: "Windows / Chrome / Edge: Ctrl + D",
    mac: "Mac / Safari / Chrome: Command (⌘) + D",
    iphone: "iPhone Safari: 공유 버튼 → 즐겨찾기에 추가 또는 홈 화면에 추가",
    android: "Android Chrome: 메뉴 (⋮) → 홈 화면에 추가 또는 북마크 추가",
  },
  en: {
    title: "Use Toolbox often? Add it to your bookmarks",
    desktop: "Desktop",
    mobile: "Mobile",
    windows: "Windows / Chrome / Edge: Ctrl + D",
    mac: "Mac / Safari / Chrome: Command (⌘) + D",
    iphone: "iPhone Safari: Share → Add to Favorites or Add to Home Screen",
    android: "Android Chrome: Menu (⋮) → Add to Home screen or Bookmark",
  },
}[lang];
---

<details class="mt-6 rounded-md border border-line bg-panel/60 px-4 py-3">
  <summary class="cursor-pointer text-sm font-semibold text-ink">{text.title}</summary>
  <div class="mt-3 rounded-md border border-line bg-white p-3 text-sm leading-6 text-slate-700">
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <p class="font-semibold text-ink">{text.desktop}</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>{text.windows}</li>
          <li>{text.mac}</li>
        </ul>
      </div>
      <div>
        <p class="font-semibold text-ink">{text.mobile}</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>{text.iphone}</li>
          <li>{text.android}</li>
        </ul>
      </div>
    </div>
  </div>
</details>
