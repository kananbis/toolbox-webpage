---
import type { Lang } from "@/i18n/translations";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = {
  ko: { setup: "참가자와 결과", count: "참가자 수", participants: "참가자", outcomes: "결과", example: "예제 불러오기", shuffle: "순서 섞기", create: "사다리 생성", new: "같은 입력으로 새 사다리", revealAll: "전체 결과 보기", copy: "결과 복사", clearPath: "경로 초기화", reset: "초기화", speed: "애니메이션 속도", instant: "즉시", fast: "빠르게", normal: "보통", slow: "느리게", result: "결과", table: "전체 결과", note: "일반적인 놀이와 간단한 무작위 선택용이며 공식 추첨 증빙 도구가 아닙니다." },
  en: { setup: "Participants and Outcomes", count: "Participant count", participants: "Participants", outcomes: "Outcomes", example: "Load Example", shuffle: "Shuffle", create: "Create Ladder", new: "New Ladder", revealAll: "Reveal All", copy: "Copy Results", clearPath: "Clear Path", reset: "Reset", speed: "Animation speed", instant: "Instant", fast: "Fast", normal: "Normal", slow: "Slow", result: "Result", table: "All Results", note: "This is for casual games and choices, not for official audited drawings." },
}[lang];
---

<div class="grid gap-5" data-ladder-game data-lang={lang}>
  <section class="rounded-md border border-line bg-white p-4">
    <h2 class="text-base font-semibold text-ink">{t.setup}</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-[160px_1fr_1fr]">
      <label>{t.count}<input data-count type="number" min="2" max="20" value="4" /></label>
      <label>{t.participants}<textarea data-participants rows="5">{lang === "ko" ? "민수\n지수\n현우\n서연" : "Alex\nJamie\nTaylor\nMorgan"}</textarea></label>
      <label>{t.outcomes}<textarea data-outcomes rows="5">{lang === "ko" ? "당첨\n꽝\n커피\n벌칙" : "Win\nTry again\nCoffee\nPenalty"}</textarea></label>
    </div>
    <div class="mt-3 flex flex-wrap gap-2">
      <button class="btn-secondary" type="button" data-example>{t.example}</button>
      <button class="btn-secondary" type="button" data-shuffle>{t.shuffle}</button>
      <button class="btn-primary" type="button" data-create>{t.create}</button>
      <button class="btn-secondary" type="button" data-new>{t.new}</button>
    </div>
  </section>
  <section class="rounded-md border border-line bg-white p-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <label class="max-w-xs">{t.speed}
        <select data-speed>
          <option value="0">{t.instant}</option>
          <option value="1200">{t.fast}</option>
          <option value="2400" selected>{t.normal}</option>
          <option value="4200">{t.slow}</option>
        </select>
      </label>
      <div class="flex flex-wrap gap-2">
        <button class="btn-secondary" type="button" data-reveal-all>{t.revealAll}</button>
        <button class="btn-secondary" type="button" data-clear-path>{t.clearPath}</button>
      </div>
    </div>
    <div class="mt-4 overflow-x-auto rounded-md border border-line bg-slate-50 p-3">
      <div data-buttons class="mb-3 flex min-w-max gap-2"></div>
      <svg data-ladder class="min-h-[360px] min-w-[560px] w-full" viewBox="0 0 800 460" role="img"></svg>
    </div>
    <p class="result-box mt-4 min-h-16" data-result aria-live="polite">-</p>
  </section>
  <section class="rounded-md border border-line bg-white p-4">
    <h2 class="text-base font-semibold text-ink">{t.table}</h2>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr><th class="border-b border-line p-2 text-left">{t.participants}</th><th class="border-b border-line p-2 text-left">{t.outcomes}</th></tr></thead>
        <tbody data-table></tbody>
      </table>
    </div>
    <div class="mt-3 flex flex-wrap gap-2">
      <button class="btn-secondary" type="button" data-copy>{t.copy}</button>
      <button class="btn-secondary" type="button" data-reset>{t.reset}</button>
    </div>
    <p class="mt-3 text-xs leading-5 text-slate-500">{t.note}</p>
    <p class="mt-2 text-sm text-slate-600" data-status aria-live="polite"></p>
  </section>
</div>

<script>
  const ladderText = {
    ko: { copied: "복사되었습니다." },
    en: { copied: "Copied." },
  };
  const random = () => crypto?.getRandomValues ? crypto.getRandomValues(new Uint32Array(1))[0] / 0xffffffff : Math.random();
  const escapeHtml = (value) => String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  const parseLines = (value, count, prefix) => {
    const lines = value.split(/\n|,/).map((item) => item.trim()).filter(Boolean);
    return Array.from({ length: count }, (_, index) => (lines[index] || `${prefix} ${index + 1}`).slice(0, 30));
  };
  const buildBars = (count) => {
    const rows = Math.max(8, Math.min(24, count + 8));
    const bars = [];
    for (let row = 1; row <= rows; row += 1) {
      let col = 0;
      while (col < count - 1) {
        if (random() < 0.34) {
          bars.push({ row, col });
          col += 2;
        } else {
          col += 1;
        }
      }
    }
    return { rows, bars };
  };
  const tracePath = (start, count, rows, bars) => {
    let col = start;
    const points = [{ row: 0, col }];
    for (let row = 1; row <= rows; row += 1) {
      points.push({ row, col });
      const right = bars.find((bar) => bar.row === row && bar.col === col);
      const left = bars.find((bar) => bar.row === row && bar.col === col - 1);
      if (right) col += 1;
      else if (left) col -= 1;
      if (right || left) points.push({ row, col });
    }
    points.push({ row: rows + 1, col });
    return { end: col, points };
  };
  const toPoint = (point, count, rows) => {
    const xGap = 700 / Math.max(1, count - 1);
    return { x: 50 + point.col * xGap, y: 70 + (point.row / (rows + 1)) * 310 };
  };
  const pathD = (points, count, rows) => points.map((point, index) => {
    const pos = toPoint(point, count, rows);
    return `${index === 0 ? "M" : "L"}${pos.x},${pos.y}`;
  }).join(" ");
  const animateSelectedPath = (root) => {
    const path = root.querySelector("[data-selected-path]");
    if (!path) return Promise.resolve();
    const duration = Number(root.querySelector("[data-speed]")?.value || 0);
    if (!duration) {
      path.setAttribute("opacity", "1");
      return Promise.resolve();
    }
    const length = path.getTotalLength();
    path.style.strokeDasharray = String(length);
    path.style.strokeDashoffset = String(length);
    path.style.transition = "none";
    path.setAttribute("opacity", "1");
    path.getBoundingClientRect();
    return new Promise((resolve) => {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          path.style.transition = `stroke-dashoffset ${duration}ms linear`;
          path.style.strokeDashoffset = "0";
          window.setTimeout(resolve, duration);
        });
      });
    });
  };
  const render = (root) => {
    const state = root._ladderState;
    if (!state) return;
    const { count, participants, outcomes, rows, bars, selectedPath } = state;
    const svg = root.querySelector("[data-ladder]");
    const xGap = 700 / Math.max(1, count - 1);
    let html = "";
    participants.forEach((name, index) => {
      const x = 50 + index * xGap;
      html += `<text x="${x}" y="28" text-anchor="middle" font-size="14" font-weight="700">${escapeHtml(name)}</text>`;
      html += `<line x1="${x}" y1="70" x2="${x}" y2="380" stroke="#94a3b8" stroke-width="3"/>`;
      html += `<text x="${x}" y="425" text-anchor="middle" font-size="14">${escapeHtml(outcomes[index])}</text>`;
    });
    bars.forEach((bar) => {
      const y = 70 + (bar.row / (rows + 1)) * 310;
      const x1 = 50 + bar.col * xGap;
      html += `<line x1="${x1}" y1="${y}" x2="${x1 + xGap}" y2="${y}" stroke="#334155" stroke-width="3"/>`;
    });
    if (selectedPath) {
      html += `<path data-selected-path="true" d="${pathD(selectedPath, count, rows)}" fill="none" stroke="#dc2626" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" opacity="0"/>`;
    }
    svg.innerHTML = html;
    root.querySelector("[data-buttons]").innerHTML = participants.map((name, index) => `<button class="btn-secondary" type="button" data-pick="${index}">${escapeHtml(name)}</button>`).join("");
  };
  const updateTable = (root, all = false) => {
    const state = root._ladderState;
    if (!state) return;
    root.querySelector("[data-table]").innerHTML = state.participants.map((name, index) => {
      const trace = tracePath(index, state.count, state.rows, state.bars);
      const value = all || state.revealed.has(index) ? state.outcomes[trace.end] : "-";
      return `<tr><td class="border-b border-line p-2">${escapeHtml(name)}</td><td class="border-b border-line p-2">${escapeHtml(value)}</td></tr>`;
    }).join("");
  };
  const create = (root) => {
    const lang = root.dataset.lang || "ko";
    const count = Math.max(2, Math.min(20, Number(root.querySelector("[data-count]").value) || 4));
    const participants = parseLines(root.querySelector("[data-participants]").value, count, lang === "ko" ? "참가자" : "Player");
    const outcomes = parseLines(root.querySelector("[data-outcomes]").value, count, lang === "ko" ? "결과" : "Result");
    const { rows, bars } = buildBars(count);
    root._ladderState = { count, participants, outcomes, rows, bars, selectedPath: null, revealed: new Set() };
    root.querySelector("[data-count]").value = String(count);
    render(root);
    updateTable(root, false);
    root.querySelector("[data-result]").textContent = "-";
  };
  const initLadder = (root) => {
    if (root.dataset.initialized) return;
    root.dataset.initialized = "true";
    const lang = root.dataset.lang || "ko";
    create(root);
    root.querySelector("[data-example]").addEventListener("click", () => {
      root.querySelector("[data-participants]").value = lang === "ko" ? "민수\n지수\n현우\n서연" : "Alex\nJamie\nTaylor\nMorgan";
      root.querySelector("[data-outcomes]").value = lang === "ko" ? "당첨\n꽝\n커피\n벌칙" : "Win\nTry again\nCoffee\nPenalty";
      root.querySelector("[data-count]").value = "4";
      create(root);
    });
    root.querySelector("[data-shuffle]").addEventListener("click", () => {
      const outcomes = root.querySelector("[data-outcomes]").value.split(/\n|,/).map((item) => item.trim()).filter(Boolean);
      for (let i = outcomes.length - 1; i > 0; i -= 1) {
        const j = Math.floor(random() * (i + 1));
        [outcomes[i], outcomes[j]] = [outcomes[j], outcomes[i]];
      }
      root.querySelector("[data-outcomes]").value = outcomes.join("\n");
      create(root);
    });
    root.querySelector("[data-create]").addEventListener("click", () => create(root));
    root.querySelector("[data-new]").addEventListener("click", () => create(root));
    root.querySelector("[data-buttons]").addEventListener("click", async (event) => {
      const button = event.target.closest("[data-pick]");
      if (!button) return;
      const state = root._ladderState;
      const index = Number(button.dataset.pick);
      const trace = tracePath(index, state.count, state.rows, state.bars);
      state.selectedPath = trace.points;
      root.querySelector("[data-result]").textContent = "-";
      render(root);
      root.querySelectorAll("[data-pick]").forEach((pickButton) => {
        pickButton.disabled = true;
      });
      await animateSelectedPath(root);
      state.revealed.add(index);
      updateTable(root, false);
      root.querySelector("[data-result]").textContent = `${state.participants[index]} → ${state.outcomes[trace.end]}`;
      root.querySelectorAll("[data-pick]").forEach((pickButton) => {
        pickButton.disabled = false;
      });
    });
    root.querySelector("[data-reveal-all]").addEventListener("click", () => updateTable(root, true));
    root.querySelector("[data-clear-path]").addEventListener("click", () => { root._ladderState.selectedPath = null; render(root); root.querySelector("[data-result]").textContent = "-"; });
    root.querySelector("[data-copy]").addEventListener("click", async () => {
      const rows = [...root.querySelectorAll("[data-table] tr")].map((row) => [...row.children].map((cell) => cell.textContent).join("\t")).join("\n");
      await navigator.clipboard?.writeText(rows);
      root.querySelector("[data-status]").textContent = ladderText[lang].copied;
    });
    root.querySelector("[data-reset]").addEventListener("click", () => {
      root.querySelector("[data-count]").value = "4";
      root.querySelector("[data-participants]").value = lang === "ko" ? "민수\n지수\n현우\n서연" : "Alex\nJamie\nTaylor\nMorgan";
      root.querySelector("[data-outcomes]").value = lang === "ko" ? "당첨\n꽝\n커피\n벌칙" : "Win\nTry again\nCoffee\nPenalty";
      create(root);
    });
  };
  document.querySelectorAll("[data-ladder-game]").forEach(initLadder);
</script>
