---
import type { Lang } from "@/i18n/translations";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = {
  ko: {
    choose: "이미지 선택",
    help: "JPG, PNG, WebP 이미지를 선택하거나 끌어다 놓으세요. 이미지는 서버로 업로드되지 않습니다.",
    settings: "픽셀 아트 설정",
    original: "원본",
    result: "결과",
    pixelSize: "픽셀 크기",
    custom: "직접 입력",
    colorCount: "색상 수",
    source: "원본 색상",
    palette: "팔레트",
    dither: "디더링",
    ditherHelp: "적은 색상으로 명암을 표현하기 위해 점무늬를 섞는 효과입니다.",
    outline: "윤곽선",
    brightness: "밝기",
    contrast: "대비",
    saturation: "채도",
    background: "배경색",
    output: "출력 형식",
    scale: "결과 크기",
    quality: "품질",
    download: "픽셀 아트 다운로드",
    reset: "초기화",
    statusEmpty: "이미지를 선택하면 결과가 표시됩니다.",
    done: "픽셀 아트가 생성되었습니다.",
  },
  en: {
    choose: "Choose Image",
    help: "Choose a JPG, PNG, or WebP image, or drop it here. Images are not uploaded to a server.",
    settings: "Pixel Art Settings",
    original: "Original",
    result: "Result",
    pixelSize: "Pixel size",
    custom: "Custom",
    colorCount: "Color count",
    source: "Original colors",
    palette: "Palette",
    dither: "Dithering",
    ditherHelp: "Dithering mixes dots to represent shading with fewer colors.",
    outline: "Outline",
    brightness: "Brightness",
    contrast: "Contrast",
    saturation: "Saturation",
    background: "Background color",
    output: "Output format",
    scale: "Result size",
    quality: "Quality",
    download: "Download Pixel Art",
    reset: "Reset",
    statusEmpty: "Choose an image to generate the result.",
    done: "Pixel art generated.",
  },
}[lang];
---

<div class="grid gap-5" data-pixel-art-editor data-lang={lang}>
  <section class="rounded-md border border-line bg-white p-4">
    <h2 class="text-base font-semibold text-ink">{t.choose}</h2>
    <label class="mt-3 grid cursor-pointer gap-2 rounded-md border border-dashed border-line bg-panel p-4 text-sm hover:border-brand" data-drop-zone>
      <input data-image-file type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" />
      <span class="text-slate-600">{t.help}</span>
    </label>
  </section>

  <section class="rounded-md border border-line bg-white p-4">
    <h2 class="text-base font-semibold text-ink">{t.settings}</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <label>{t.pixelSize}
        <select data-pixel-size>
          {[2, 4, 6, 8, 12, 16, 24, 32].map((size) => <option value={size} selected={size === 8}>{size}px</option>)}
          <option value="custom">{t.custom}</option>
        </select>
      </label>
      <label>{t.custom}
        <input data-custom-pixel-size type="number" min="1" max="64" value="8" />
      </label>
      <label>{t.colorCount}
        <select data-color-count>
          <option value="0">{t.source}</option>
          {[4, 8, 16, 32, 64].map((count) => <option value={count} selected={count === 16}>{count}</option>)}
        </select>
      </label>
      <label>{t.palette}
        <select data-palette>
          <option value="source">{t.source}</option>
          <option value="mono">{lang === "ko" ? "흑백" : "Black and white"}</option>
          <option value="gameboy">{lang === "ko" ? "Game Boy 스타일" : "Game Boy style"}</option>
          <option value="eightbit">{lang === "ko" ? "8비트 컬러" : "8-bit color"}</option>
          <option value="pastel">{lang === "ko" ? "파스텔" : "Pastel"}</option>
          <option value="neon">{lang === "ko" ? "네온" : "Neon"}</option>
          <option value="warm">{lang === "ko" ? "따뜻한 색감" : "Warm"}</option>
          <option value="cool">{lang === "ko" ? "차가운 색감" : "Cool"}</option>
        </select>
      </label>
      <label>{t.dither}
        <select data-dither>
          <option value="none">{lang === "ko" ? "사용 안 함" : "None"}</option>
          <option value="floyd">Floyd-Steinberg</option>
          <option value="bayer2">Bayer 2x2</option>
          <option value="bayer4">Bayer 4x4</option>
        </select>
        <span class="mt-1 block text-xs text-slate-500">{t.ditherHelp}</span>
      </label>
      <label>{lang === "ko" ? "디더링 강도" : "Dithering strength"}
        <input data-dither-strength type="range" min="0" max="100" value="50" />
      </label>
      <label>{t.outline}
        <select data-outline>
          <option value="none">{lang === "ko" ? "사용 안 함" : "None"}</option>
          <option value="light">{lang === "ko" ? "약하게" : "Light"}</option>
          <option value="normal">{lang === "ko" ? "보통" : "Normal"}</option>
          <option value="strong">{lang === "ko" ? "강하게" : "Strong"}</option>
        </select>
      </label>
      <label>{lang === "ko" ? "윤곽선 색상" : "Outline color"}
        <span class="color-control">
          <input id="pixel-outline-color" data-outline-color type="color" value="#111827" />
          <input class="color-hex" data-color-hex-for="pixel-outline-color" type="text" value="#111827" maxlength="7" spellcheck="false" aria-label={lang === "ko" ? "외곽선 색상 HEX 값" : "Outline color HEX value"} />
        </span>
      </label>
      <label>{t.brightness}<input data-brightness type="range" min="-100" max="100" value="0" /></label>
      <label>{t.contrast}<input data-contrast type="range" min="-100" max="100" value="0" /></label>
      <label>{t.saturation}<input data-saturation type="range" min="0" max="200" value="100" /></label>
      <label>{t.background}
        <span class="color-control">
          <input id="pixel-background-color" data-background type="color" value="#ffffff" />
          <input class="color-hex" data-color-hex-for="pixel-background-color" type="text" value="#FFFFFF" maxlength="7" spellcheck="false" aria-label={lang === "ko" ? "배경색 HEX 값" : "Background color HEX value"} />
        </span>
      </label>
      <label>{t.output}
        <select data-output-format>
          <option value="image/png">PNG</option>
          <option value="image/webp">WebP</option>
          <option value="image/jpeg">JPG</option>
        </select>
      </label>
      <label>{t.scale}
        <select data-output-scale>
          <option value="1">1x</option>
          <option value="2" selected>2x</option>
          <option value="4">4x</option>
        </select>
      </label>
      <label>{t.quality}<input data-quality type="range" min="10" max="100" value="90" /></label>
    </div>
  </section>

  <section class="rounded-md border border-line bg-white p-4">
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <h3 class="text-sm font-semibold">{t.original}</h3>
        <div class="mt-2 overflow-auto rounded-md border border-line bg-white p-2">
          <img data-original-preview class="max-h-[480px] max-w-full object-contain" alt="" />
        </div>
      </div>
      <div>
        <h3 class="text-sm font-semibold">{t.result}</h3>
        <div class="mt-2 overflow-auto rounded-md border border-line bg-white p-2">
          <canvas data-result-canvas class="max-h-[480px] max-w-full"></canvas>
        </div>
      </div>
    </div>
    <p class="result-box mt-4 whitespace-pre-wrap text-sm" data-status aria-live="polite">{t.statusEmpty}</p>
    <div class="mt-4 grid gap-2 sm:grid-cols-[auto_auto] sm:justify-between">
      <button class="btn-secondary" type="button" data-reset>{t.reset}</button>
      <button class="btn-primary" type="button" data-download disabled>{t.download}</button>
    </div>
  </section>
</div>

<script>
  import { canvasToBlob, createPixelArt } from "@/utils/pixel-art";

  const messages = {
    ko: { unsupported: "JPG, PNG, WebP 이미지만 사용할 수 있습니다.", failed: "이미지 처리에 실패했습니다. 더 작은 이미지로 다시 시도해주세요.", done: "픽셀 아트가 생성되었습니다.", empty: "이미지를 선택하면 결과가 표시됩니다." },
    en: { unsupported: "Only JPG, PNG, and WebP images are supported.", failed: "Image processing failed. Try a smaller image.", done: "Pixel art generated.", empty: "Choose an image to generate the result." },
  };

  const debounce = (callback, delay) => {
    let timer = 0;
    return (...args) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => callback(...args), delay);
    };
  };
  const filename = (name, mimeType) => `${(name || "image").replace(/\.[^.]+$/, "")}-pixel-art.${mimeType === "image/webp" ? "webp" : mimeType === "image/jpeg" ? "jpg" : "png"}`;
  const getSettings = (root) => ({
    pixelSize: root.querySelector("[data-pixel-size]")?.value === "custom" ? Number(root.querySelector("[data-custom-pixel-size]")?.value || 8) : Number(root.querySelector("[data-pixel-size]")?.value || 8),
    colorCount: Number(root.querySelector("[data-color-count]")?.value || 16),
    palette: root.querySelector("[data-palette]")?.value || "source",
    customPalette: [],
    dither: root.querySelector("[data-dither]")?.value || "none",
    ditherStrength: Number(root.querySelector("[data-dither-strength]")?.value || 50),
    outline: root.querySelector("[data-outline]")?.value || "none",
    outlineColor: root.querySelector("[data-outline-color]")?.value || "#111827",
    brightness: Number(root.querySelector("[data-brightness]")?.value || 0),
    contrast: Number(root.querySelector("[data-contrast]")?.value || 0),
    saturation: Number(root.querySelector("[data-saturation]")?.value || 100),
    backgroundColor: root.querySelector("[data-background]")?.value || "#ffffff",
    outputFormat: root.querySelector("[data-output-format]")?.value || "image/png",
    outputScale: Number(root.querySelector("[data-output-scale]")?.value || 2),
    quality: Number(root.querySelector("[data-quality]")?.value || 90) / 100,
  });
  const process = (root) => {
    const image = root._pixelImage;
    const status = root.querySelector("[data-status]");
    if (!image) {
      status.textContent = messages[root.dataset.lang].empty;
      return;
    }
    try {
      const canvas = createPixelArt(image, getSettings(root));
      const target = root.querySelector("[data-result-canvas]");
      target.width = canvas.width;
      target.height = canvas.height;
      target.getContext("2d").drawImage(canvas, 0, 0);
      root.querySelector("[data-download]").disabled = false;
      status.textContent = messages[root.dataset.lang].done;
    } catch {
      status.textContent = messages[root.dataset.lang].failed;
    }
  };
  const initPixelArt = (root) => {
    if (root.dataset.initialized) return;
    root.dataset.initialized = "true";
    const input = root.querySelector("[data-image-file]");
    const status = root.querySelector("[data-status]");
    const run = debounce(() => process(root), 80);
    const loadFile = (file) => {
      if (!file || !/^image\/(jpeg|png|webp)$/.test(file.type)) {
        status.textContent = messages[root.dataset.lang].unsupported;
        return;
      }
      const image = new Image();
      const url = URL.createObjectURL(file);
      image.onload = () => {
        if (root._pixelUrl) URL.revokeObjectURL(root._pixelUrl);
        root._pixelUrl = url;
        root._pixelImage = image;
        root._pixelFileName = file.name;
        root.querySelector("[data-original-preview]").src = url;
        process(root);
      };
      image.onerror = () => {
        URL.revokeObjectURL(url);
        status.textContent = messages[root.dataset.lang].failed;
      };
      image.src = url;
    };
    input.addEventListener("change", () => loadFile(input.files?.[0]));
    root.querySelector("[data-drop-zone]").addEventListener("dragover", (event) => event.preventDefault());
    root.querySelector("[data-drop-zone]").addEventListener("drop", (event) => {
      event.preventDefault();
      loadFile(event.dataTransfer?.files?.[0]);
    });
    root.querySelectorAll("input, select").forEach((field) => field.addEventListener("input", run));
    root.querySelector("[data-download]").addEventListener("click", async () => {
      const canvas = root.querySelector("[data-result-canvas]");
      const settings = getSettings(root);
      const blob = await canvasToBlob(canvas, settings.outputFormat, settings.quality);
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename(root._pixelFileName, settings.outputFormat);
      a.click();
      URL.revokeObjectURL(url);
    });
    root.querySelector("[data-reset]").addEventListener("click", () => {
      if (root._pixelUrl) URL.revokeObjectURL(root._pixelUrl);
      root._pixelImage = null;
      root._pixelUrl = "";
      input.value = "";
      root.querySelector("[data-original-preview]").removeAttribute("src");
      const canvas = root.querySelector("[data-result-canvas]");
      canvas.getContext("2d")?.clearRect(0, 0, canvas.width, canvas.height);
      root.querySelector("[data-download]").disabled = true;
      status.textContent = messages[root.dataset.lang].empty;
    });
  };
  document.querySelectorAll("[data-pixel-art-editor]").forEach(initPixelArt);
</script>
