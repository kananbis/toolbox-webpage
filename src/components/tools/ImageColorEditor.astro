---
import type { Lang } from "@/i18n/translations";

type Props = {
  mode: "replace" | "transparent";
  lang: Lang;
};

const { mode, lang } = Astro.props;
const text = {
  ko: {
    file: "이미지 파일",
    uploadHelp: "JPG, PNG, WebP 이미지를 선택하거나 이 영역에 끌어다 놓으세요.",
    sectionImage: "이미지 파일",
    sectionTarget: "대상 색상",
    sectionOptions: "대체 옵션",
    sectionResult: "결과 확인 및 저장",
    privacy: "선택한 이미지는 서버로 업로드되지 않고 브라우저 안에서만 처리됩니다.",
    large: "이미지 해상도가 크면 브라우저 처리 시간이 길어질 수 있습니다.",
    pickHelp: "이미지에서 바꿀 원본 색상을 선택하거나 HEX 값으로 입력하세요.",
    eyedropper: "화면에서 색상 선택",
    eyedropperHelp: "화면에서 색상 선택은 미리보기 배경과 합성되어 보이는 색상을 선택할 수 있습니다.",
    previewBackground: "미리보기 배경",
    previewBackgroundHelp: "투명 영역을 체크무늬나 단색 배경 위에서 확인합니다. 이 배경은 다운로드 이미지에 포함되지 않습니다.",
    checkerboardBackground: "체크무늬",
    whiteBackground: "흰색",
    blackBackground: "검은색",
    customBackground: "사용자 지정 색상",
    backgroundColor: "배경색",
    targetColor: "변경할 원본 색상",
    newColor: "새 색상",
    replacementHex: "새 색상 HEX",
    pickReplacementColor: "화면에서 새 색상 선택",
    replacementScope: "적용 범위",
    replaceAll: "이미지 전체",
    replaceConnected: "선택한 연속 영역만",
    replaceConnectedHelp: "원본 이미지에서 대상 색상과 바꿀 영역을 한 번에 선택합니다.",
    pickTargetColor: "원본 이미지에서 대상 색상 선택",
    originalImage: "원본 이미지",
    originalImageSelect: "원본 이미지 - 클릭하여 대상 색상과 영역 선택",
    tolerance: "유사 색상 범위",
    toleranceHelp: "낮은 값은 같은 색조와 채도를 우선해 처리합니다. 값을 높이면 밝기 차이와 유사 색상까지 더 넓게 포함합니다.",
    transparencyMode: "투명화 방식",
    full: "완전 투명",
    soft: "부드럽게 투명",
    reduceFringe: "가장자리 색상 번짐 줄이기",
    reduceFringeHelp: "투명 처리된 가장자리의 배경색 테두리를 줄입니다.",
    outputFormat: "출력 형식",
    quality: "품질",
    original: "원본",
    result: "결과",
    statusInitial: "",
    statusPick: "",
    download: "다운로드",
    downloadPng: "PNG 다운로드",
    downloadWebp: "WebP 다운로드",
    downloadJpg: "JPG 다운로드",
    reset: "초기화",
    disabledHelp: "",
    pngWebpAlpha: "PNG와 WebP는 투명도를 유지할 수 있습니다.",
    jpgWhite: "JPG는 투명도를 지원하지 않아 투명 영역을 흰색 배경과 합성합니다.",
    alpha: "투명도",
    alphaUnknown: "투명도 확인 불가",
    transparentPixel: "투명 픽셀",
  },
  en: {
    file: "Image file",
    uploadHelp: "Choose a JPG, PNG, or WebP image, or drag it here.",
    sectionImage: "Image File",
    sectionTarget: "Source Color",
    sectionOptions: "Replacement Options",
    sectionResult: "Preview and Save",
    privacy: "Selected images are not uploaded to a server and are processed only in your browser.",
    large: "Large images may take longer to process in your browser.",
    pickHelp: "Choose the original color to replace from the image or enter a HEX value.",
    eyedropper: "Pick screen color",
    eyedropperHelp: "Screen color picking may select the color as composited with the preview background.",
    previewBackground: "Preview background",
    previewBackgroundHelp: "Shows transparent areas on a checkerboard or solid color. This background is not included in the downloaded image.",
    checkerboardBackground: "Checkerboard",
    whiteBackground: "White",
    blackBackground: "Black",
    customBackground: "Custom color",
    backgroundColor: "Background color",
    targetColor: "Original color to replace",
    newColor: "New color",
    replacementHex: "New color HEX",
    pickReplacementColor: "Pick new screen color",
    replacementScope: "Apply to",
    replaceAll: "Entire image",
    replaceConnected: "Selected connected area only",
    replaceConnectedHelp: "Choose the source color and connected area together from the original image.",
    pickTargetColor: "Choose source color from original image",
    originalImage: "Original image",
    originalImageSelect: "Original image - click to select the source color and area",
    tolerance: "Color tolerance",
    toleranceHelp: "Lower values prioritize similar hue and saturation. Higher values include a wider range of brightness and similar colors.",
    transparencyMode: "Transparency mode",
    full: "Fully transparent",
    soft: "Soft transparency",
    reduceFringe: "Reduce color fringe",
    reduceFringeHelp: "Reduces background color edges around transparent pixels.",
    outputFormat: "Output format",
    quality: "Quality",
    original: "Original",
    result: "Result",
    statusInitial: "",
    statusPick: "",
    download: "Download",
    downloadPng: "Download PNG",
    downloadWebp: "Download WebP",
    downloadJpg: "Download JPG",
    reset: "Reset",
    disabledHelp: "",
    pngWebpAlpha: "PNG and WebP can preserve transparency.",
    jpgWhite: "JPG does not support transparency, so transparent areas are composited on a white background.",
    alpha: "Alpha",
    alphaUnknown: "alpha unavailable",
    transparentPixel: "transparent pixel",
  },
}[lang];
---

<div class="grid gap-5" data-image-color-editor data-mode={mode} data-lang={lang}>
  <section class="rounded-md border border-line bg-white p-4">
    <h2 class="text-base font-semibold text-ink">{text.sectionImage}</h2>
    <label class="mt-3 grid cursor-pointer gap-2 rounded-md border border-dashed border-line bg-panel p-4 text-sm hover:border-brand" data-drop-zone>
      <input class="mt-1" data-image-file type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" />
      <span class="text-slate-600">{text.uploadHelp}</span>
    </label>
  </section>

  <fieldset class="grid gap-5" data-editor-options disabled>
    <section class="rounded-md border border-line bg-white p-4">
      <h2 class="text-base font-semibold text-ink">{text.sectionTarget}</h2>
      <p class="mt-2 text-sm text-slate-600">{text.pickHelp}</p>
      <div class="mt-4 grid gap-3 md:grid-cols-[minmax(160px,1fr)_auto_auto] md:items-end">
        <label class="grid gap-2 text-sm">
          <span class="font-medium text-ink">{text.targetColor}</span>
          <input data-target-hex type="text" value="#FFFFFF" inputmode="text" autocomplete="off" />
        </label>
        <div class="flex flex-wrap items-center gap-2 text-sm text-slate-700 md:pb-2">
          <span class="h-8 w-8 rounded border border-line" data-target-swatch></span>
          <span class="font-medium text-ink" data-target-hex-display>#FFFFFF</span>
          <span class="text-slate-500" data-target-rgb-display>rgb(255, 255, 255)</span>
        </div>
        <button class="btn-secondary w-full md:w-auto" type="button" data-eyedropper>{text.pickTargetColor}</button>
      </div>
    </section>

    <section class="rounded-md border border-line bg-white p-4">
      <h2 class="text-base font-semibold text-ink">{text.sectionOptions}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        {mode === "replace" ? (
          <>
            <div class="grid gap-2">
              <span class="text-sm font-medium text-ink">{text.newColor}</span>
              <div class="grid gap-2 sm:grid-cols-[48px_minmax(0,1fr)_auto] sm:items-center">
                <input class="h-10 w-12" data-replacement-color type="color" value="#2563EB" aria-label={text.newColor} />
                <input data-replacement-hex type="text" value="#2563EB" inputmode="text" autocomplete="off" aria-label={text.replacementHex} />
                <button class="btn-secondary w-full sm:w-auto" type="button" data-replacement-eyedropper>{text.pickReplacementColor}</button>
              </div>
            </div>
            <fieldset class="grid gap-2 text-sm">
              <legend class="font-medium text-ink">{text.replacementScope}</legend>
              <div class="grid grid-cols-2 gap-2">
                <label class="flex min-h-10 cursor-pointer items-center gap-2 rounded border border-line bg-panel px-3">
                  <input class="w-auto" data-replacement-scope name="replacement-scope" type="radio" value="all" checked />
                  <span>{text.replaceAll}</span>
                </label>
                <label class="flex min-h-10 cursor-pointer items-center gap-2 rounded border border-line bg-panel px-3">
                  <input class="w-auto" data-replacement-scope name="replacement-scope" type="radio" value="connected" />
                  <span>{text.replaceConnected}</span>
                </label>
              </div>
              <span class="hidden text-xs leading-5 text-slate-500" data-connected-area-help>{text.replaceConnectedHelp}</span>
            </fieldset>
          </>
        ) : (
          <>
            <label class="grid gap-2 text-sm">
              <span class="font-medium text-ink">{text.transparencyMode}</span>
              <select data-transparency-mode>
                <option value="full">{text.full}</option>
                <option value="soft">{text.soft}</option>
              </select>
            </label>
            <label class="grid gap-1 text-sm">
              <span class="flex items-center gap-2 font-medium text-ink">
                <input class="w-auto" data-reduce-fringe type="checkbox" checked />
                <span>{text.reduceFringe}</span>
              </span>
              <span class="text-xs leading-5 text-slate-500">{text.reduceFringeHelp}</span>
            </label>
          </>
        )}

        <div class="grid gap-2 text-sm md:col-span-2">
          <span class="font-medium text-ink">{text.tolerance}</span>
          <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_120px]">
            <input data-tolerance-range type="range" min="0" max="100" value="10" />
            <input data-tolerance-number type="number" min="0" max="100" value="10" aria-label={text.tolerance} />
          </div>
          <p class="text-xs leading-5 text-slate-500">{text.toleranceHelp}</p>
        </div>

        <label class="grid gap-2 text-sm">
          <span class="font-medium text-ink">{text.previewBackground}</span>
          <select data-preview-background-mode>
            <option value="checkerboard">{text.checkerboardBackground}</option>
            <option value="white">{text.whiteBackground}</option>
            <option value="black">{text.blackBackground}</option>
            <option value="custom">{text.customBackground}</option>
          </select>
          <span class="min-h-10 text-xs leading-5 text-slate-500">{text.previewBackgroundHelp}</span>
        </label>
        <label class="hidden grid gap-2 text-sm" data-preview-background-color-row>
          <span class="font-medium text-ink">{text.backgroundColor}</span>
          <span class="color-control">
            <input id="image-color-editor-preview-background-color" data-preview-background-color type="color" value="#FF00FF" />
            <input class="color-hex" data-preview-background-color-hex type="text" value="#FF00FF" maxlength="7" spellcheck="false" aria-label={`${text.backgroundColor} HEX`} />
          </span>
        </label>

        <label class="grid gap-2 text-sm">
          <span class="font-medium text-ink">{text.outputFormat}</span>
          <select data-output-format>
            <option value="image/png">PNG</option>
            <option value="image/webp">WebP</option>
            {mode === "replace" && <option value="image/jpeg">JPG</option>}
          </select>
          <span class="min-h-10 text-xs leading-5 text-slate-500">{mode === "transparent" ? text.pngWebpAlpha : `${text.pngWebpAlpha} ${text.jpgWhite}`}</span>
        </label>
        <label data-quality-row class="hidden grid gap-2 text-sm">
          <span class="font-medium text-ink">{text.quality}</span>
          <input data-quality type="range" min="10" max="100" value="90" />
        </label>
      </div>
    </section>
  </fieldset>

  <section class="rounded-md border border-line bg-white p-4">
    <h2 class="text-base font-semibold text-ink">{text.sectionResult}</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <section>
        <h3 class="text-sm font-semibold" data-original-preview-title data-default-title={text.originalImage} data-select-title={text.originalImageSelect}>{text.originalImage}</h3>
        <div class="relative mt-2 flex justify-center overflow-auto rounded-md border border-line bg-white p-2" data-original-preview>
          <canvas data-original-canvas class="max-h-[520px] max-w-full" aria-label={text.originalImage} tabindex="0"></canvas>
          <span class="pointer-events-none absolute hidden h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-red-500 bg-white/70" data-connected-seed-marker aria-hidden="true"></span>
        </div>
        <canvas class="pointer-events-none fixed z-20 hidden h-28 w-28 rounded-md border-2 border-slate-700 bg-white shadow-lg [image-rendering:pixelated]" data-original-loupe aria-hidden="true"></canvas>
      </section>
      <section>
        <h3 class="text-sm font-semibold">{text.result}</h3>
        <div class:list={["mt-2 flex justify-center overflow-auto rounded-md border border-line p-2", mode === "transparent" ? "checkerboard" : "bg-white"]} data-result-preview>
          <canvas data-result-canvas class="max-h-[520px] max-w-full" aria-label={text.result}></canvas>
        </div>
      </section>
    </div>
    <div class="mt-5 grid gap-3 sm:grid-cols-[auto_auto] sm:items-center sm:justify-between">
      <button class="btn-secondary order-2 w-full sm:order-1 sm:w-auto" type="button" data-reset>{text.reset}</button>
      <a class="btn-primary order-1 w-full pointer-events-none opacity-50 sm:order-2 sm:w-auto" data-download-link download>{text.downloadPng}</a>
    </div>
  </section>

  <p class="result-box hidden whitespace-pre-wrap" data-status aria-live="polite">{text.statusInitial}</p>
</div>

<style>
  .checkerboard {
    background-color: #cbd5e1;
    background-image:
      linear-gradient(45deg, #94a3b8 25%, transparent 25%),
      linear-gradient(-45deg, #94a3b8 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #94a3b8 75%),
      linear-gradient(-45deg, transparent 75%, #94a3b8 75%);
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    background-size: 16px 16px;
  }
</style>

<script>
  import {
    applyColorReplacement,
    applyColorTransparency,
    buildOutputFilename,
    createDownloadBlob,
    parseHexColor,
    rgbToHex,
    rgbToText,
  } from "@/utils/image-color";

  const labels = {
    ko: {
      chooseImage: "이미지를 선택하세요.",
      unsupported: "지원하지 않는 이미지 형식입니다. JPG, PNG, WebP 파일을 사용해보세요.",
      decodeFailed: "이미지를 읽을 수 없습니다. 손상된 파일이거나 브라우저에서 지원하지 않는 형식일 수 있습니다.",
      invalidHex: "HEX 색상 값을 올바르게 입력해주세요.",
      pickColor: "",
      processing: "이미지를 처리하는 중입니다.",
      done: "결과가 생성되었습니다.",
      failed: "이미지 처리에 실패했습니다. 더 작은 이미지나 다른 파일로 다시 시도해주세요.",
      downloadFailed: "다운로드 파일 생성에 실패했습니다.",
      eyeDropperCancelled: "색상 선택이 취소되었습니다.",
    },
    en: {
      chooseImage: "Choose an image first.",
      unsupported: "Unsupported image format. Try a JPG, PNG, or WebP file.",
      decodeFailed: "This image could not be read. It may be damaged or unsupported by the browser.",
      invalidHex: "Please enter a valid HEX color value.",
      pickColor: "",
      processing: "Processing image.",
      done: "Result generated.",
      failed: "Image processing failed. Try a smaller image or a different file.",
      downloadFailed: "Could not create the download file.",
      eyeDropperCancelled: "Color picking was cancelled.",
    },
  };

  const debounce = (callback, delay) => {
    let timer = 0;
    const run = (...args) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => callback(...args), delay);
    };
    run.cancel = () => {
      window.clearTimeout(timer);
      timer = 0;
    };
    return run;
  };

  const hasTransparentPixels = (imageData) => imageData.data.some((value, index) => index % 4 === 3 && value < 255);

  const getPreviewBackground = (root) => {
    const mode = root.querySelector("[data-preview-background-mode]")?.value || "checkerboard";
    const color = root.querySelector("[data-preview-background-color]")?.value || "#ff00ff";
    return { mode, color };
  };

  const setPreviewTransparencyBackground = (root, element, enabled) => {
    if (!element) return;
    const previewBackground = getPreviewBackground(root);
    // Preview background is a display preference, not only an alpha indicator.
    // Apply it to both source and result panes so their surrounding canvas areas match.
    element.classList.toggle("checkerboard", previewBackground.mode === "checkerboard");
    element.classList.toggle("bg-white", previewBackground.mode === "white");
    if (previewBackground.mode === "checkerboard") {
      element.style.backgroundColor = "";
      return;
    }
    const solidColors = {
      white: "#ffffff",
      black: "#000000",
      custom: previewBackground.color,
    };
    element.style.backgroundColor = solidColors[previewBackground.mode] || "#ffffff";
  };

  const revokeDownload = (root) => {
    const url = root.dataset.downloadUrl;
    if (url) URL.revokeObjectURL(url);
    root.dataset.downloadUrl = "";
    const link = root.querySelector("[data-download-link]");
    link?.removeAttribute("href");
    link?.classList.add("pointer-events-none", "opacity-50");
  };

  const updateDownloadLabel = (root) => {
    const lang = root.dataset.lang || "ko";
    const outputFormat = root.querySelector("[data-output-format]")?.value || "image/png";
    const link = root.querySelector("[data-download-link]");
    if (!link) return;
    const labelsByFormat = lang === "ko"
      ? { "image/png": "PNG 다운로드", "image/webp": "WebP 다운로드", "image/jpeg": "JPG 다운로드" }
      : { "image/png": "Download PNG", "image/webp": "Download WebP", "image/jpeg": "Download JPG" };
    link.textContent = labelsByFormat[outputFormat] || labelsByFormat["image/png"];
  };

  const setStatus = (root, message) => {
    const status = root.querySelector("[data-status]");
    if (status) {
      status.textContent = message;
      status.classList.toggle("hidden", !message);
    }
  };

  const setHexControls = (colorInput, hexInput, color) => {
    const hex = rgbToHex(color);
    if (colorInput) colorInput.value = hex;
    if (hexInput) hexInput.value = hex;
  };

  const syncSwatch = (root) => {
    const target = parseHexColor(root.querySelector("[data-target-hex]")?.value || "");
    const swatch = root.querySelector("[data-target-swatch]");
    const hexDisplay = root.querySelector("[data-target-hex-display]");
    const rgbDisplay = root.querySelector("[data-target-rgb-display]");
    if (!target || !swatch || !hexDisplay || !rgbDisplay) return;
    swatch.style.backgroundColor = rgbToHex(target);
    hexDisplay.textContent = rgbToHex(target);
    rgbDisplay.textContent = rgbToText(target);
  };

  const getReplacementScope = (root) => root.dataset.currentReplacementScope || "all";

  const loadImage = async (file) => {
    const url = URL.createObjectURL(file);
    try {
      const image = new Image();
      image.decoding = "async";
      image.src = url;
      await image.decode();
      return image;
    } finally {
      URL.revokeObjectURL(url);
    }
  };

  const drawSource = (root, image) => {
    const originalCanvas = root.querySelector("[data-original-canvas]");
    const originalPreviewTitle = root.querySelector("[data-original-preview-title]");
    const resultCanvas = root.querySelector("[data-result-canvas]");
    const originalPreview = root.querySelector("[data-original-preview]");
    const originalContext = originalCanvas?.getContext("2d", { willReadFrequently: true });
    const resultContext = resultCanvas?.getContext("2d");
    if (!originalCanvas || !resultCanvas || !originalContext || !resultContext) throw new Error("Canvas context could not be created.");

    originalCanvas.width = image.naturalWidth;
    originalCanvas.height = image.naturalHeight;
    resultCanvas.width = image.naturalWidth;
    resultCanvas.height = image.naturalHeight;
    originalContext.clearRect(0, 0, originalCanvas.width, originalCanvas.height);
    originalContext.drawImage(image, 0, 0);
    resultContext.clearRect(0, 0, resultCanvas.width, resultCanvas.height);
    resultContext.drawImage(image, 0, 0);
    root._sourceImageData = originalContext.getImageData(0, 0, originalCanvas.width, originalCanvas.height);
    setPreviewTransparencyBackground(root, originalPreview, hasTransparentPixels(root._sourceImageData));
  };

  const processImage = async (root, scopeOverride) => {
    const lang = root.dataset.lang || "ko";
    const mode = root.dataset.mode;
    const message = labels[lang] || labels.en;
    const sourceImageData = root._sourceImageData;
    if (!sourceImageData) {
      setStatus(root, message.chooseImage);
      return;
    }

    const targetColor = parseHexColor(root.querySelector("[data-target-hex]")?.value || "");
    if (!targetColor) {
      setStatus(root, message.invalidHex);
      revokeDownload(root);
      return;
    }

    // Scope changes must render from the original pixels with the exact mode the user selected.
    // Passing it from the radio handler prevents an earlier "all" render from being reused.
    const replacementScope = scopeOverride || getReplacementScope(root);
    if (mode === "replace" && replacementScope === "connected" && !root._replacementSeed) {
      setStatus(root, root.querySelector("[data-connected-area-help]")?.textContent || "Select an area in the original preview.");
      revokeDownload(root);
      return;
    }

    const resultCanvas = root.querySelector("[data-result-canvas]");
    const resultContext = resultCanvas?.getContext("2d");
    if (!resultCanvas || !resultContext) {
      setStatus(root, message.failed);
      return;
    }

    setStatus(root, message.processing);
    revokeDownload(root);

    try {
      const tolerance = Number(root.querySelector("[data-tolerance-number]")?.value || 25);
      const outputImageData = mode === "replace"
        ? applyColorReplacement(sourceImageData, {
          targetColor,
          replacementColor: parseHexColor(root.querySelector("[data-replacement-hex]")?.value || "") || { r: 37, g: 99, b: 235 },
          tolerance,
          scope: replacementScope,
          seed: root._replacementSeed || undefined,
        })
        : applyColorTransparency(sourceImageData, {
          targetColor,
          tolerance,
          mode: root.querySelector("[data-transparency-mode]")?.value === "soft" ? "soft" : "full",
          reduceFringe: Boolean(root.querySelector("[data-reduce-fringe]")?.checked),
        });

      resultCanvas.width = outputImageData.width;
      resultCanvas.height = outputImageData.height;
      resultContext.putImageData(outputImageData, 0, 0);
      const resultPreview = root.querySelector("[data-result-preview]");
      root._resultHasTransparency = hasTransparentPixels(outputImageData);
      setPreviewTransparencyBackground(root, resultPreview, mode === "transparent" || root._resultHasTransparency);

      const outputFormat = root.querySelector("[data-output-format]")?.value || "image/png";
      const quality = Number(root.querySelector("[data-quality]")?.value || 90) / 100;
      const blob = await createDownloadBlob(resultCanvas, outputFormat, quality);
      const url = URL.createObjectURL(blob);
      const link = root.querySelector("[data-download-link]");
      root.dataset.downloadUrl = url;
      if (link) {
        link.href = url;
        link.download = buildOutputFilename(root._sourceFileName || "image", mode === "replace" ? "-color-replaced" : "-transparent", outputFormat);
        updateDownloadLabel(root);
        link.classList.remove("pointer-events-none", "opacity-50");
      }
      setStatus(root, message.done);
    } catch (error) {
      setStatus(root, message.failed);
    }
  };

  const initEditor = (root) => {
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const lang = root.dataset.lang || "ko";
    const mode = root.dataset.mode;
    const message = labels[lang] || labels.en;
    const fileInput = root.querySelector("[data-image-file]");
    const options = root.querySelector("[data-editor-options]");
    const targetHex = root.querySelector("[data-target-hex]");
    const replacementColor = root.querySelector("[data-replacement-color]");
    const replacementHex = root.querySelector("[data-replacement-hex]");
    const replacementScopeInputs = root.querySelectorAll("[data-replacement-scope]");
    const connectedAreaHelp = root.querySelector("[data-connected-area-help]");
    const toleranceRange = root.querySelector("[data-tolerance-range]");
    const toleranceNumber = root.querySelector("[data-tolerance-number]");
    const outputFormat = root.querySelector("[data-output-format]");
    const qualityRow = root.querySelector("[data-quality-row]");
    const originalPreview = root.querySelector("[data-original-preview]");
    const previewBackgroundMode = root.querySelector("[data-preview-background-mode]");
    const previewBackgroundColor = root.querySelector("[data-preview-background-color]");
    const previewBackgroundColorHex = root.querySelector("[data-preview-background-color-hex]");
    const previewBackgroundColorRow = root.querySelector("[data-preview-background-color-row]");
    const dropZone = root.querySelector("[data-drop-zone]");
    const replacementEyedropperButton = root.querySelector("[data-replacement-eyedropper]");
    const originalCanvas = root.querySelector("[data-original-canvas]");
    const originalPreviewTitle = root.querySelector("[data-original-preview-title]");
    const connectedSeedMarker = root.querySelector("[data-connected-seed-marker]");
    const originalLoupe = root.querySelector("[data-original-loupe]");
    const debouncedProcess = debounce(() => processImage(root), 140);

    const reset = () => {
      revokeDownload(root);
      root._sourceImageData = null;
      root._sourceFileName = "";
      root._replacementSeed = null;
      root._pickingTargetFromImage = false;
      connectedSeedMarker?.classList.add("hidden");
      if (fileInput) fileInput.value = "";
      options?.setAttribute("disabled", "");
      if (previewBackgroundMode) previewBackgroundMode.value = "checkerboard";
      if (previewBackgroundColor) previewBackgroundColor.value = "#ff00ff";
      if (previewBackgroundColorHex) previewBackgroundColorHex.value = "#FF00FF";
      if (previewBackgroundColorRow) previewBackgroundColorRow.classList.add("hidden");
      root._resultHasTransparency = false;
      setPreviewTransparencyBackground(root, originalPreview, false);
      originalPreview?.classList.remove("ring-2", "ring-brand");
      setPreviewTransparencyBackground(root, root.querySelector("[data-result-preview]"), mode === "transparent");
      [root.querySelector("[data-original-canvas]"), root.querySelector("[data-result-canvas]")].forEach((canvas) => {
        const context = canvas?.getContext("2d");
        if (canvas && context) {
          context.clearRect(0, 0, canvas.width, canvas.height);
          canvas.width = 300;
          canvas.height = 120;
        }
      });
      setHexControls(null, targetHex, { r: 255, g: 255, b: 255 });
      if (replacementColor && replacementHex) setHexControls(replacementColor, replacementHex, { r: 37, g: 99, b: 235 });
      replacementScopeInputs.forEach((input) => {
        input.checked = input.value === "all";
      });
      root.dataset.currentReplacementScope = "all";
      toleranceRange.value = "10";
      toleranceNumber.value = "10";
      syncSwatch(root);
      updateDownloadLabel(root);
      setStatus(root, "");
    };

    const handleFile = async (file) => {
      if (!file) return;
      revokeDownload(root);
      if (!["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
        setStatus(root, message.unsupported);
        return;
      }
      try {
        const image = await loadImage(file);
        drawSource(root, image);
        root._sourceFileName = file.name;
        root._replacementSeed = null;
        root._pickingTargetFromImage = false;
        root.dataset.currentReplacementScope = "all";
        replacementScopeInputs.forEach((input) => {
          input.checked = input.value === "all";
        });
        connectedSeedMarker?.classList.add("hidden");
        options?.removeAttribute("disabled");
        setStatus(root, message.pickColor);
      } catch {
        setStatus(root, message.decodeFailed);
      }
    };

    fileInput?.addEventListener("click", () => {
      fileInput.value = "";
    });
    fileInput?.addEventListener("change", () => handleFile(fileInput.files?.[0]));
    dropZone?.addEventListener("dragover", (event) => {
      event.preventDefault();
      dropZone.classList.add("border-brand");
    });
    dropZone?.addEventListener("dragleave", () => dropZone.classList.remove("border-brand"));
    dropZone?.addEventListener("drop", (event) => {
      event.preventDefault();
      dropZone.classList.remove("border-brand");
      const file = event.dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });

    const syncTargetFromHex = () => {
      const color = parseHexColor(targetHex.value);
      if (!color) {
        setStatus(root, message.invalidHex);
        revokeDownload(root);
        return;
      }
      targetHex.value = rgbToHex(color);
      syncSwatch(root);
      debouncedProcess();
    };
    targetHex?.addEventListener("change", syncTargetFromHex);

    if (replacementColor && replacementHex) {
      replacementColor.addEventListener("input", () => {
        const color = parseHexColor(replacementColor.value);
        if (!color) return;
        replacementHex.value = rgbToHex(color);
        debouncedProcess();
      });
      replacementHex.addEventListener("change", () => {
        const color = parseHexColor(replacementHex.value);
        if (!color) {
          setStatus(root, message.invalidHex);
          revokeDownload(root);
          return;
        }
        replacementColor.value = rgbToHex(color);
        replacementHex.value = rgbToHex(color);
        debouncedProcess();
      });
    }

    const updateSeedMarker = () => {
      const seed = root._replacementSeed;
      if (!seed || !root._sourceImageData || !originalCanvas || !originalPreview || !connectedSeedMarker) return;
      const canvasBounds = originalCanvas.getBoundingClientRect();
      const previewBounds = originalPreview.getBoundingClientRect();
      connectedSeedMarker.style.left = `${canvasBounds.left - previewBounds.left + ((seed.x + 0.5) / root._sourceImageData.width) * canvasBounds.width}px`;
      connectedSeedMarker.style.top = `${canvasBounds.top - previewBounds.top + ((seed.y + 0.5) / root._sourceImageData.height) * canvasBounds.height}px`;
    };

    const hideOriginalLoupe = () => originalLoupe?.classList.add("hidden");
    const updateOriginalLoupe = (event) => {
      const selectingConnectedArea = mode === "replace" && getReplacementScope(root) === "connected";
      if ((!root._pickingTargetFromImage && !selectingConnectedArea) || !root._sourceImageData || !originalCanvas || !originalLoupe) {
        hideOriginalLoupe();
        return;
      }
      const bounds = originalCanvas.getBoundingClientRect();
      const x = Math.max(0, Math.min(originalCanvas.width - 1, Math.floor((event.clientX - bounds.left) * originalCanvas.width / bounds.width)));
      const y = Math.max(0, Math.min(originalCanvas.height - 1, Math.floor((event.clientY - bounds.top) * originalCanvas.height / bounds.height)));
      const context = originalLoupe.getContext("2d");
      if (!context) return;
      const sourceSize = Math.min(13, originalCanvas.width, originalCanvas.height);
      const sourceX = Math.max(0, Math.min(originalCanvas.width - sourceSize, x - Math.floor(sourceSize / 2)));
      const sourceY = Math.max(0, Math.min(originalCanvas.height - sourceSize, y - Math.floor(sourceSize / 2)));
      originalLoupe.width = 130;
      originalLoupe.height = 130;
      context.imageSmoothingEnabled = false;
      context.clearRect(0, 0, originalLoupe.width, originalLoupe.height);
      context.drawImage(originalCanvas, sourceX, sourceY, sourceSize, sourceSize, 0, 0, originalLoupe.width, originalLoupe.height);
      context.strokeStyle = "#ef4444";
      context.lineWidth = 2;
      context.strokeRect(60, 60, 10, 10);
      originalLoupe.style.left = `${Math.min(window.innerWidth - 128, event.clientX + 16)}px`;
      originalLoupe.style.top = `${Math.min(window.innerHeight - 128, event.clientY + 16)}px`;
      originalLoupe.classList.remove("hidden");
    };

    const updateReplacementScope = () => {
      const connected = mode === "replace" && getReplacementScope(root) === "connected";
      connectedAreaHelp?.classList.toggle("hidden", !connected);
      originalCanvas?.classList.toggle("cursor-crosshair", connected);
      if (originalPreviewTitle) {
        originalPreviewTitle.textContent = connected
          ? originalPreviewTitle.dataset.selectTitle
          : originalPreviewTitle.dataset.defaultTitle;
      }
      if (connected && root._replacementSeed) {
        updateSeedMarker();
        connectedSeedMarker?.classList.remove("hidden");
      } else {
        connectedSeedMarker?.classList.add("hidden");
      }
      originalPreview?.classList.remove("ring-2", "ring-brand");
    };
    const renderReplacementScope = (input) => {
      if (!input.checked) return;
      const scope = input.value === "connected" ? "connected" : "all";
      root.dataset.currentReplacementScope = scope;
      updateReplacementScope();
      window.requestAnimationFrame(() => {
        void processImage(root, scope);
      });
    };
    replacementScopeInputs.forEach((input) => {
      input.addEventListener("change", () => renderReplacementScope(input));
    });
    originalCanvas?.addEventListener("pointerdown", (event) => {
      const selectingTarget = root._pickingTargetFromImage;
      const selectingConnectedArea = mode === "replace" && getReplacementScope(root) === "connected";
      if ((!selectingTarget && !selectingConnectedArea) || !root._sourceImageData) return;
      const bounds = originalCanvas.getBoundingClientRect();
      const x = Math.floor((event.clientX - bounds.left) * root._sourceImageData.width / bounds.width);
      const y = Math.floor((event.clientY - bounds.top) * root._sourceImageData.height / bounds.height);
      const safeX = Math.max(0, Math.min(root._sourceImageData.width - 1, x));
      const safeY = Math.max(0, Math.min(root._sourceImageData.height - 1, y));
      const pixelIndex = (safeY * root._sourceImageData.width + safeX) * 4;
      const sourceColor = {
        r: root._sourceImageData.data[pixelIndex],
        g: root._sourceImageData.data[pixelIndex + 1],
        b: root._sourceImageData.data[pixelIndex + 2],
      };
      root._replacementSeed = { x: safeX, y: safeY };
      setHexControls(null, targetHex, sourceColor);
      syncSwatch(root);
      root._pickingTargetFromImage = false;
      updateSeedMarker();
      if (selectingConnectedArea) connectedSeedMarker?.classList.remove("hidden");
      originalPreview?.classList.remove("ring-2", "ring-brand");
      hideOriginalLoupe();
      debouncedProcess();
    });
    originalCanvas?.addEventListener("pointermove", updateOriginalLoupe);
    originalCanvas?.addEventListener("pointerleave", hideOriginalLoupe);

    const syncTolerance = (source) => {
      const value = Math.max(0, Math.min(100, Number(source.value) || 0));
      toleranceRange.value = String(value);
      toleranceNumber.value = String(value);
      debouncedProcess();
    };
    toleranceRange?.addEventListener("input", () => syncTolerance(toleranceRange));
    toleranceNumber?.addEventListener("input", () => syncTolerance(toleranceNumber));

    root.querySelectorAll("select, input[type='checkbox'], [data-quality]").forEach((input) => {
      if (input.matches("[data-preview-background-mode], [data-output-format]")) return;
      input.addEventListener("input", () => {
        if (qualityRow && outputFormat) qualityRow.classList.toggle("hidden", outputFormat.value === "image/png");
        debouncedProcess();
      });
    });
    outputFormat?.addEventListener("change", () => {
      qualityRow?.classList.toggle("hidden", outputFormat.value === "image/png");
      updateDownloadLabel(root);
      debouncedProcess();
    });

    const updatePreviewBackgrounds = () => {
      const sourceImageData = root._sourceImageData;
      previewBackgroundColorRow?.classList.toggle("hidden", previewBackgroundMode?.value !== "custom");
      setPreviewTransparencyBackground(root, originalPreview, Boolean(sourceImageData && hasTransparentPixels(sourceImageData)));
      setPreviewTransparencyBackground(root, root.querySelector("[data-result-preview]"), mode === "transparent" || Boolean(root._resultHasTransparency));
    };
    previewBackgroundMode?.addEventListener("input", updatePreviewBackgrounds);
    previewBackgroundColor?.addEventListener("input", () => {
      if (previewBackgroundColorHex) {
        previewBackgroundColorHex.value = previewBackgroundColor.value.toUpperCase();
        previewBackgroundColorHex.setAttribute("aria-invalid", "false");
      }
      updatePreviewBackgrounds();
    });
    previewBackgroundColorHex?.addEventListener("input", () => {
      const value = previewBackgroundColorHex.value.trim();
      if (!/^#[0-9a-fA-F]{6}$/.test(value)) {
        previewBackgroundColorHex.setAttribute("aria-invalid", "true");
        return;
      }
      previewBackgroundColorHex.setAttribute("aria-invalid", "false");
      if (previewBackgroundColor) previewBackgroundColor.value = value.toLowerCase();
      previewBackgroundColorHex.value = value.toUpperCase();
      updatePreviewBackgrounds();
    });
    previewBackgroundColorHex?.addEventListener("change", () => {
      if (!previewBackgroundColor) return;
      previewBackgroundColorHex.value = previewBackgroundColor.value.toUpperCase();
      previewBackgroundColorHex.setAttribute("aria-invalid", "false");
    });

    const eyedropperButton = root.querySelector("[data-eyedropper]");
    const eyedropperHelp = root.querySelector("[data-eyedropper-help]");
    if (!("EyeDropper" in window)) {
      replacementEyedropperButton?.classList.add("hidden");
      eyedropperHelp?.classList.add("hidden");
    }
    const pickScreenColor = async (applyColor) => {
      if (!("EyeDropper" in window)) return;
      try {
        const eyeDropper = new window.EyeDropper();
        const result = await eyeDropper.open();
        const color = parseHexColor(result.sRGBHex);
        if (!color) {
          setStatus(root, message.invalidHex);
          return;
        }
        applyColor(color);
        debouncedProcess();
      } catch {
        // User cancellation is expected; keep the current color and status.
      }
    };
    eyedropperButton?.addEventListener("click", () => {
      if (!originalPreview) return;
      root._pickingTargetFromImage = true;
      connectedSeedMarker?.classList.add("hidden");
      originalPreview.classList.add("ring-2", "ring-brand");
      originalPreview.scrollIntoView({ behavior: "smooth", block: "center" });
      window.setTimeout(() => originalCanvas?.focus({ preventScroll: true }), 250);
    });
    replacementEyedropperButton?.addEventListener("click", () => {
      pickScreenColor((color) => {
        if (replacementColor && replacementHex) {
          setHexControls(replacementColor, replacementHex, color);
        }
      });
    });

    root.querySelector("[data-reset]")?.addEventListener("click", reset);
    root.dataset.currentReplacementScope = "all";
    updateReplacementScope();
    syncSwatch(root);
    updateDownloadLabel(root);
  };

  document.querySelectorAll("[data-image-color-editor]").forEach(initEditor);
</script>
