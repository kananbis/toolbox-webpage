  const format = (value, lang) => Number.isFinite(value) ? new Intl.NumberFormat(lang === "ko" ? "ko-KR" : "en-US", { maximumFractionDigits: 4 }).format(value) : messages[lang].cannotCalculate;
  const money = (value, lang) => Number.isFinite(value) ? new Intl.NumberFormat(lang === "ko" ? "ko-KR" : "en-US", { maximumFractionDigits: 0 }).format(value) : messages[lang].cannotCalculate;
  const formatResistance = (value, lang) => {
    if (!Number.isFinite(value)) return messages[lang].cannotCalculate;
    if (Math.abs(value) >= 1000000) return `${format(value / 1000000, lang)} MΩ`;
    if (Math.abs(value) >= 1000) return `${format(value / 1000, lang)} kΩ`;
    return `${format(value, lang)} Ω`;
  };
  const formatFrequency = (value, lang) => {
    if (!Number.isFinite(value)) return messages[lang].cannotCalculate;
    if (Math.abs(value) >= 1000000) return `${format(value / 1000000, lang)} MHz`;
    if (Math.abs(value) >= 1000) return `${format(value / 1000, lang)} kHz`;
    return `${format(value, lang)} Hz`;
  };
  const formatTime = (value, lang) => {
    if (!Number.isFinite(value)) return messages[lang].cannotCalculate;
    if (Math.abs(value) < 0.001) return `${format(value * 1000000, lang)} µs`;
    if (Math.abs(value) < 1) return `${format(value * 1000, lang)} ms`;
    return `${format(value, lang)} s`;
  };
  const formatPrecise = (value, lang) => {
    if (!Number.isFinite(value)) return messages[lang].cannotCalculate;
    if (value !== 0 && Math.abs(value) < 0.000001) return value.toExponential(6);
