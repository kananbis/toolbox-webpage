---
import Layout from "@/components/Layout.astro";
import { i18n, languages, type Lang } from "@/i18n/translations";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = i18n[lang];
const otherLang = lang === "ko" ? "en" : "ko";
const title = lang === "ko" ? `소개 - ${t.siteName}` : `About - ${t.siteName}`;
const description =
  lang === "ko"
    ? "Toolbox는 오디오, PDF, 이미지, 계산기, 변환기, 텍스트 도구를 제공하는 무료 온라인 도구 모음입니다."
    : "Toolbox is a free collection of browser-based tools for audio, PDF, images, calculations, conversions, and text tasks.";
---

<Layout
  title={title}
  description={description}
  canonical={`/${lang}/about`}
  lang={lang}
  alternates={[{ lang: otherLang, href: `/${otherLang}/about` }, { lang: "x-default", href: "/ko/about" }]}
>
  <article class="prose-lite max-w-3xl">
    <h1 class="text-3xl font-bold">{lang === "ko" ? "소개" : "About"}</h1>
    {
      lang === "ko" ? (
        <>
          <p class="mt-4">Toolbox는 자주 필요한 파일 처리와 계산 작업을 빠르게 처리할 수 있도록 만든 무료 온라인 도구 사이트입니다.</p>
          <p>오디오 압축, 오디오 자르기, 아이폰 벨소리 만들기, PDF 합치기와 정리, 이미지 리사이즈와 색상 추출, 텍스트 도구, 계산기, 변환기, 개발자 도구를 제공합니다.</p>
          <p>대부분의 도구는 입력한 내용이나 선택한 파일을 서버로 보내지 않고 현재 브라우저 안에서 처리합니다.</p>
          <h2>운영 방향</h2>
          <p>Toolbox는 설치 없이 사용할 수 있는 가볍고 실용적인 웹 도구를 목표로 합니다. 정적 사이트 구조를 유지하면서 모바일과 데스크톱에서 빠르게 열리고, 필요한 기능을 복잡한 가입 절차 없이 사용할 수 있게 만드는 데 집중합니다.</p>
        </>
      ) : (
        <>
          <p class="mt-4">Toolbox is a free online tool site for quick file processing, calculations, and everyday web tasks.</p>
          <p>It provides audio compression, audio trimming, iPhone ringtone creation, PDF merging and organization, image resizing and color picking, text tools, calculators, converters, and developer utilities.</p>
          <p>Most tools process your input or selected files directly in your current browser without sending them to a server.</p>
          <h2>Our Direction</h2>
          <p>Toolbox focuses on lightweight, practical web tools that work without installation. The site keeps a static, low-complexity structure while making each tool easy to use on both mobile and desktop devices.</p>
        </>
      )
    }
  </article>
</Layout>
