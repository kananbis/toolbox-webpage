          if (text.startsWith("RIFF") && text.slice(8, 12) === "WEBP") return "image/webp";
          if (bytes[0] === 0x42 && bytes[1] === 0x4d) return "image/bmp";
          if (text.slice(4, 16).includes("ftypavif") || text.slice(4, 16).includes("ftypavis")) return "image/avif";
