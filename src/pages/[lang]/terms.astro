---
import Layout from "@/components/Layout.astro";
import { i18n, languages, type Lang } from "@/i18n/translations";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = i18n[lang];
const otherLang = lang === "ko" ? "en" : "ko";
const title = lang === "ko" ? `이용약관 - ${t.siteName}` : `Terms of Use - ${t.siteName}`;
const description =
  lang === "ko"
    ? "Toolbox 도구 결과의 참고 목적, 파일 사용 권한, 저작권, 브라우저 처리 제한, 서비스 변경 기준을 안내합니다."
    : "Terms of use for Toolbox, including reference-only results, file rights, copyright, browser limitations, and service changes.";
---

<Layout
  title={title}
  description={description}
  canonical={`/${lang}/terms`}
  lang={lang}
  alternates={[{ lang: otherLang, href: `/${otherLang}/terms` }, { lang: "x-default", href: "/ko/terms" }]}
>
  <article class="prose-lite max-w-3xl">
    <h1 class="text-3xl font-bold">{lang === "ko" ? "이용약관" : "Terms of Use"}</h1>
    {
      lang === "ko" ? (
        <>
          <p class="mt-4">Toolbox는 무료 웹 유틸리티를 참고용으로 제공합니다. 사이트를 사용하면 아래 조건을 이해하고 동의한 것으로 봅니다.</p>
          <h2>결과의 참고 목적</h2>
          <p>계산, 변환, 파일 편집 결과는 사용자의 입력값, 브라우저 지원 범위, 파일 상태, 선택한 옵션에 따라 달라질 수 있습니다. 모든 결과는 참고용이며 특정 목적의 정확성, 완전성, 호환성을 보장하지 않습니다.</p>
          <h2>전문 조언이 아님</h2>
          <p>금융, 법률, 의료, 세무, 전자 회로 관련 계산 결과는 전문 조언을 대체하지 않습니다. 대출, 투자, 건강, 계약, 실제 제품 설계처럼 중요한 결정에는 공식 자료나 전문가 검토가 필요합니다.</p>
          <h2>파일 변환과 호환성</h2>
          <p>파일 변환 결과는 브라우저, 코덱, 외부 라이브러리, 원본 파일 손상 여부, 파일 크기에 따라 달라질 수 있습니다. 어떤 출력 파일이 모든 프로그램과 기기에서 동일하게 열리거나 재생된다고 보장하지 않습니다.</p>
          <h2>파일 사용 권한과 저작권</h2>
          <p>사용자는 본인이 소유했거나 편집할 권한이 있는 파일만 사용해야 합니다. 저작권이 있는 파일을 무단으로 변환, 편집, 배포하거나 DRM을 우회하는 용도로 사이트를 사용해서는 안 됩니다.</p>
          <h2>브라우저와 기기 제한</h2>
          <p>큰 이미지, PDF, 오디오 파일은 브라우저 메모리를 많이 사용할 수 있습니다. 모바일 기기나 오래된 브라우저에서는 처리 시간이 길어지거나 실패할 수 있습니다.</p>
          <h2>외부 라이브러리와 CDN</h2>
          <p>일부 도구는 PDF, 오디오, QR 코드 처리 등을 위해 브라우저용 라이브러리를 사용합니다. 외부 CDN 또는 라이브러리 장애, 브라우저 보안 정책 변경, 네트워크 문제로 기능이 일시적으로 작동하지 않을 수 있습니다.</p>
          <h2>원본 파일 보관</h2>
          <p>도구는 원본을 직접 수정하지 않고 새 결과 파일을 만드는 방식으로 제공됩니다. 그래도 작업 전 중요한 원본 파일은 별도로 보관해야 합니다.</p>
          <h2>서비스 변경과 중단</h2>
          <p>Toolbox는 기능, 문구, 지원 형식, 페이지 구성을 사전 공지 없이 변경하거나 중단할 수 있습니다. 오류 수정과 품질 개선을 위해 기존 UI나 옵션이 바뀔 수 있습니다.</p>
          <h2>사용자 책임</h2>
          <p>사용자는 도구 결과를 직접 확인하고, 결과 사용에 따른 책임을 부담합니다. 사이트는 사용자가 결과를 바탕으로 내린 결정이나 파일 사용으로 발생한 손해를 보장하지 않습니다.</p>
        </>
      ) : (
        <>
          <p class="mt-4">Toolbox provides free web utilities for reference use. By using the site, you understand and agree to the following terms.</p>
          <h2>Reference-Only Results</h2>
          <p>Calculation, conversion, and file editing results can vary depending on user input, browser support, file condition, and selected options. Results are provided for reference and are not guaranteed to be accurate, complete, compatible, or fit for a specific purpose.</p>
          <h2>Not Professional Advice</h2>
          <p>Financial, legal, medical, tax, and electronics calculations do not replace professional advice. Important decisions involving loans, investments, health, contracts, or real product design should be verified with official sources or qualified professionals.</p>
          <h2>File Conversion and Compatibility</h2>
          <p>File conversion results may vary by browser, codec, external library support, damaged files, and file size. The site does not guarantee that every output file will open or play identically in every program or device.</p>
          <h2>File Rights and Copyright</h2>
          <p>You should only use files that you own or have the right to edit. Do not use the site to convert, edit, distribute copyrighted files without permission, or bypass DRM.</p>
          <h2>Browser and Device Limits</h2>
          <p>Large images, PDFs, and audio files may use significant browser memory. Processing can be slow or fail on mobile devices or older browsers.</p>
          <h2>External Libraries and CDNs</h2>
          <p>Some tools use browser-side libraries for PDF, audio, QR code, and other processing. External CDN issues, library changes, browser security policies, or network problems may temporarily affect functionality.</p>
          <h2>Keep Original Files</h2>
          <p>Tools are designed to create new output files rather than directly modify originals. You should still keep backup copies of important original files before processing them.</p>
          <h2>Service Changes</h2>
          <p>Toolbox may change or discontinue features, text, supported formats, or page structure without prior notice. UI and options may change as bugs are fixed and quality improves.</p>
          <h2>User Responsibility</h2>
          <p>You are responsible for reviewing results and for decisions made based on them. The site does not guarantee losses or issues caused by use of the results or files.</p>
        </>
      )
    }
  </article>
</Layout>
