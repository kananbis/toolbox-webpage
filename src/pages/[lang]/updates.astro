---
import Layout from "@/components/Layout.astro";
import { getSiteUpdates } from "@/data/site-updates";
import { getTool, i18n, languages, type Lang } from "@/i18n/translations";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = i18n[lang];
const otherLang = lang === "ko" ? "en" : "ko";
const updates = getSiteUpdates(lang);
const title = lang === "ko" ? `Toolbox 업데이트 - ${t.siteName}` : `Toolbox Updates - ${t.siteName}`;
const description = lang === "ko"
  ? "Toolbox의 최근 도구 개선, 지원 범위 변경, 검증 방식을 확인합니다."
  : "Review recent Toolbox tool improvements, support changes, and validation notes.";
---

<Layout
  title={title}
  description={description}
  canonical={`/${lang}/updates`}
  lang={lang}
  alternates={[{ lang: otherLang, href: `/${otherLang}/updates` }, { lang: "x-default", href: "/ko/updates" }]}
>
  <article class="prose-lite max-w-4xl">
    <h1 class="text-3xl font-bold md:text-4xl">{lang === "ko" ? "Toolbox 업데이트" : "Toolbox Updates"}</h1>
    <p class="mt-4 text-lg leading-8 text-slate-700">
      {lang === "ko"
        ? "배포된 기능과 확인한 제한 사항을 기록합니다. 지원하지 않거나 검증되지 않은 기능은 업데이트 항목에 포함하지 않습니다."
        : "This page records deployed features and verified limitations. It does not list features that have not been tested or released."}
    </p>

    <div class="mt-8 space-y-5">
      {updates.map((update) => {
        const tool = update.toolSlug ? getTool(lang, update.toolSlug) : undefined;
        return (
          <section class="rounded-lg border border-line bg-white p-5">
            <p class="text-sm font-semibold text-brand">{update.date}</p>
            <h2 class="mt-2 text-xl font-bold">{update.title}</h2>
            <p class="mt-2 text-slate-700">{update.summary}</p>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-slate-700">
              {update.details.map((detail) => <li>{detail}</li>)}
            </ul>
            {tool && <a class="mt-4 inline-flex text-sm font-semibold" href={tool.path}>{lang === "ko" ? `${tool.name} 열기` : `Open ${tool.name}`}</a>}
          </section>
        );
      })}
    </div>
  </article>
</Layout>
