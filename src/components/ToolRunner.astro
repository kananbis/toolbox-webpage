          stopMergerPreview(root);
          const transitions = getMergerTransitions(root);
          const index = Number(target.dataset.index);
          if (transitions[index]) {
            if (target.dataset.mergerTransition === "mode") transitions[index].mode = target.value;
            if (target.dataset.mergerTransition === "duration") transitions[index].duration = Math.max(0, Number(target.value) || 0);
          }
          updateMergerSummary(root);
        }
        if (["merger-output-format", "merger-bitrate", "merger-sample-rate", "merger-channels", "merger-normalize"].includes(target?.id)) {
          if (target?.id === "merger-output-format") syncAudioOutputOptions(root);
          state.resultBlob = null;
        }
      });
      root.addEventListener("dragstart", (event) => {
        if (event.target.closest("input, button, select, textarea, .trim-handle")) {
          event.stopPropagation();
          return;
        }
        const card = event.target.closest(".merger-file-card");
        if (card) event.dataTransfer?.setData("text/plain", card.dataset.mergerId || "");
      });
      root.addEventListener("dragover", (event) => {
        if (event.target.closest(".merger-file-card") || event.target.closest("#merger-drop-zone")) event.preventDefault();
      });
      root.addEventListener("drop", (event) => {
        const dropZone = event.target.closest("#merger-drop-zone");
        if (dropZone) {
          event.preventDefault();
          loadAudioMergerFiles(root, event.dataTransfer?.files).catch((error) => {
            root.querySelector("#result").textContent = error instanceof Error ? error.message : messages[root.dataset.lang || "ko"].checkInput;
            setMergerStatus(root, error instanceof Error ? error.message : messages[root.dataset.lang || "ko"].checkInput, 0);
          });
          return;
        }
        const targetCard = event.target.closest(".merger-file-card");
        const sourceId = event.dataTransfer?.getData("text/plain");
        if (targetCard && sourceId) {
          event.preventDefault();
          const state = getMergerState(root);
          const from = state.items.findIndex((item) => item.id === sourceId);
          const to = state.items.findIndex((item) => item.id === targetCard.dataset.mergerId);
          if (from >= 0 && to >= 0 && from !== to) {
            stopMergerPreview(root);
            const [item] = state.items.splice(from, 1);
            state.items.splice(to, 0, item);
            renderAudioMerger(root);
          }
        }
      });
      const resultAudio = root.querySelector("#audio-output-preview");
      if (resultAudio) {
        resultAudio.addEventListener("play", () => startMergerResultPlayhead(root));
        resultAudio.addEventListener("pause", () => stopMergerResultPlayhead(root));
        resultAudio.addEventListener("ended", () => stopMergerResultPlayhead(root));
        resultAudio.addEventListener("seeked", () => drawMergerResultWaveformFrame(root));
        resultAudio.addEventListener("timeupdate", () => {
          if (resultAudio.paused) drawMergerResultWaveformFrame(root);
        });
      }
      renderAudioMerger(root);
    }
    const mosaicCanvas = root.querySelector("#mosaic-canvas");
    if (mosaicCanvas) {
      let startPoint = null;
      let isDragging = false;
      mosaicCanvas.addEventListener("pointerdown", (event) => {
        if (!root._mosaicState) return;
        event.preventDefault();
        mosaicCanvas.setPointerCapture?.(event.pointerId);
        startPoint = pointOnCanvas(mosaicCanvas, event);
        isDragging = true;
        setMosaicSelection(root, { x: startPoint.x, y: startPoint.y, width: 0, height: 0 });
        drawMosaicPreview(root);
      });
      mosaicCanvas.addEventListener("pointermove", (event) => {
        if (!isDragging || !startPoint) return;
        event.preventDefault();
        const point = pointOnCanvas(mosaicCanvas, event);
        const selection = {
          x: Math.min(startPoint.x, point.x),
          y: Math.min(startPoint.y, point.y),
          width: Math.abs(point.x - startPoint.x),
          height: Math.abs(point.y - startPoint.y),
        };
        setMosaicSelection(root, selection);
        drawMosaicPreview(root);
      });
      const stopMosaicDrag = async (event) => {
        if (!isDragging) return;
        event.preventDefault();
        isDragging = false;
        startPoint = null;
        drawMosaicPreview(root);
        try {
          await refreshMosaicOutput(root);
        } catch (error) {
          root.querySelector("#result").textContent = error instanceof Error ? error.message : messages[root.dataset.lang || "ko"].checkInput;
        }
      };
      mosaicCanvas.addEventListener("pointerup", stopMosaicDrag);
      mosaicCanvas.addEventListener("pointercancel", stopMosaicDrag);
    }
    const colorCanvas = root.querySelector("#color-canvas");
    if (colorCanvas) {
      colorCanvas.addEventListener("click", (event) => {
        pickCanvasColor(root, event).catch((error) => {
          root.querySelector("#result").textContent = error instanceof Error ? error.message : messages[root.dataset.lang || "ko"].checkInput;
        });
      });
    }
    syncDynamicInputs(root);
    initTimeZoneConverter(root);
    if (slug === "audio-cutter" || slug === "iphone-ringtone-maker") {
      initRingtonePointerEvents(root);
      let resizeTimer = 0;
      window.addEventListener("resize", () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => requestRingtoneDraw(root), 120);
      });
      updateRingtoneUi(root);
    }
    if (slug === "time-zone-converter") run(root);
    if (selectOnlyAutoRunSlugs.has(slug)) autoRun();
  });
</script>

