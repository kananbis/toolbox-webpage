---
import Layout from "@/components/Layout.astro";
import { i18n, languages, type Lang } from "@/i18n/translations";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = i18n[lang];
const otherLang = lang === "ko" ? "en" : "ko";
const title = lang === "ko" ? `소개 - ${t.siteName}` : `About - ${t.siteName}`;
const description =
  lang === "ko"
    ? "Toolbox는 오디오, PDF, 이미지, 계산기, 변환기, 텍스트 작업을 브라우저에서 처리하는 무료 웹 도구 모음입니다."
    : "Toolbox is a free collection of browser-based tools for audio, PDF, image, calculation, conversion, and text tasks.";
---

<Layout
  title={title}
  description={description}
  canonical={`/${lang}/about`}
  lang={lang}
  alternates={[{ lang: otherLang, href: `/${otherLang}/about` }, { lang: "x-default", href: "/ko/about" }]}
>
  <article class="prose-lite max-w-4xl">
    <h1 class="text-3xl font-bold">{lang === "ko" ? "소개" : "About"}</h1>
    {
      lang === "ko" ? (
        <>
          <p class="mt-4">Toolbox는 설치나 로그인 없이 바로 사용할 수 있는 무료 웹 도구 모음입니다. 오디오 편집, PDF 정리, 이미지 처리, 날짜와 비율 계산, 단위 변환, 텍스트 정리처럼 반복적으로 필요한 작업을 가볍게 처리하는 것을 목표로 합니다.</p>
          <h2>Toolbox를 만든 이유</h2>
          <p>간단한 이미지, PDF, 오디오 작업을 위해 별도 프로그램을 설치하거나 파일을 외부 서버에 업로드해야 하는 불편을 줄이기 위해 Toolbox를 만들고 있습니다. 브라우저에서 안전하게 처리할 수 있는 작업은 가능한 한 로컬에서 처리하고, 필요한 기능을 하나씩 추가하면서 도구별 제한 사항도 함께 공개합니다.</p>
          <h2>제공하는 도구 범위</h2>
          <p>현재 사이트에는 이미지 압축과 리사이즈, PDF 합치기와 페이지 정리, 오디오 변환과 자르기, 시간대 변환, QR 코드 생성, 글자수 세기, 전자 계산기, 랜덤 선택 도구 등이 포함되어 있습니다. 각 도구는 독립된 페이지로 제공되며, 해당 작업의 사용 방법과 제한사항을 함께 안내합니다.</p>
          <h2>브라우저 처리 원칙</h2>
          <p>가능한 도구는 사용자의 현재 브라우저 안에서 처리합니다. 텍스트 입력값, 계산값, 선택한 이미지/PDF/오디오 파일은 도구 기능을 수행하기 위해 브라우저 메모리에서 사용되며, 별도의 서버 업로드 방식으로 처리하지 않습니다.</p>
          <p>오디오 변환이나 일부 특수 이미지 형식처럼 실행 구성 요소가 필요한 기능은 외부 CDN에서 필요한 코드나 WASM을 내려받을 수 있습니다. 이 경우 내려받는 것은 처리 엔진 파일이며, 사용자가 선택한 파일이나 메타데이터 자체를 CDN으로 전송하지 않습니다.</p>
          <h2>계산과 변환 기준</h2>
          <p>계산기와 변환기는 페이지에 표시된 공식, 단위, 반올림 기준을 바탕으로 결과를 만듭니다. 금융, 전자, 건강 관련 계산은 빠른 참고용이며 실제 계약, 구매, 진단, 설계 검증을 대신하지 않습니다.</p>
          <h2>지원 형식과 검증</h2>
          <p>파일 도구는 브라우저와 사용 중인 라이브러리에서 실제로 처리 가능한 형식만 UI에 표시하는 것을 원칙으로 합니다. 브라우저, 운영체제, 파일 손상 여부, 파일 크기, 코덱 세부 정보에 따라 같은 형식이라도 처리 결과가 달라질 수 있습니다.</p>
          <h2>업데이트와 오류 제보</h2>
          <p>도구 기능과 설명은 새 형식 지원, 브라우저 호환성, 사용자 제보에 따라 업데이트될 수 있습니다. 배포된 기능과 검증한 제한 사항은 <a href="/ko/updates/">업데이트 기록</a>에 남깁니다. 오류를 발견하면 문의 페이지에 안내된 정보와 함께 재현 순서를 보내주세요.</p>
          <h2>개발과 검증 방식</h2>
          <p>도구는 Astro와 TypeScript, 브라우저 API를 중심으로 구현합니다. 파일 형식 처리처럼 무거운 기능은 필요한 경우에만 실행 구성 요소를 불러오며, 지원 여부는 실제 파일 처리 결과와 브라우저 호환성을 기준으로 안내합니다. 새 기능은 결과 미리보기, 다운로드 파일, 오류 처리, 모바일 레이아웃을 함께 점검합니다.</p>
          <p>지원하지 않는 파일 형식이나 안전하게 검증되지 않은 편집 기능을 지원한다고 표시하지 않는 것을 원칙으로 합니다. 중요한 파일은 항상 원본을 보관한 뒤 결과를 확인하세요.</p>
          <h2>광고 운영 원칙</h2>
          <p>사이트 운영 비용을 충당하기 위해 광고를 사용할 수 있습니다. 광고는 도구 사용을 방해하지 않는 위치에 배치하는 것을 원칙으로 하며, 광고 기능이 비활성화된 상태에서는 빈 광고 영역을 표시하지 않습니다.</p>
          <h2>보장하지 않는 범위</h2>
          <p>Toolbox는 전문 서비스나 공식 인증 도구가 아닙니다. 변환 결과의 모든 프로그램 호환성, 계산 결과의 법적 효력, 파일 처리 성공, 특정 브라우저에서의 성능을 보장하지 않습니다. 중요한 파일은 작업 전에 원본을 보관하세요.</p>
        </>
      ) : (
        <>
          <p class="mt-4">Toolbox is a free web utility site that works without installation or sign-in. It is built for everyday tasks such as editing audio, organizing PDFs, processing images, calculating dates and percentages, converting units, and cleaning up text.</p>
          <h2>Why Toolbox Exists</h2>
          <p>Toolbox is being built to reduce the need to install separate programs or upload files to an outside service for simple image, PDF, and audio tasks. Work that can be handled safely in the browser is kept local where possible, while feature limits are published alongside each tool.</p>
          <h2>What the Site Provides</h2>
          <p>The site includes tools for image compression and resizing, PDF merging and page editing, audio conversion and trimming, time zone conversion, QR code creation, character counting, electronics calculations, and random selection. Each tool has its own page with usage notes and limitations.</p>
          <h2>Browser-Based Processing</h2>
          <p>Where possible, tools run directly in your current browser. Text input, calculation values, and selected image, PDF, or audio files are used in browser memory for the selected task and are not processed through a server upload workflow.</p>
          <p>Some audio tools and specialized image formats may download the code or WASM runtime they need from an external CDN. Those downloads are processing engines; your selected files and metadata are not sent to the CDN.</p>
          <h2>Calculation and Conversion Standards</h2>
          <p>Calculators and converters use the formulas, units, and rounding rules shown on each page. Financial, electronics, and health-related results are quick references and do not replace contracts, product validation, diagnosis, or professional review.</p>
          <h2>Format Support and Testing</h2>
          <p>File tools should show only formats that are supported by the browser and the libraries used by the page. Results can still vary by browser, operating system, damaged files, file size, codec details, and device memory.</p>
          <h2>Updates and Bug Reports</h2>
          <p>Tool features and explanations may be updated as browser support changes and issues are reported. Deployed features and verified limitations are recorded in the <a href="/en/updates/">update log</a>. If you find a problem, use the Contact page and include the tool name, browser, file type, error message, and steps to reproduce it.</p>
          <h2>Development and Validation</h2>
          <p>Tools are built primarily with Astro, TypeScript, and browser APIs. Heavier file-processing components are loaded only when needed, and support is described from real file handling and browser compatibility rather than API names alone. New features are checked with previews, downloaded results, error handling, and mobile layouts.</p>
          <p>The site does not claim support for file formats or editing operations that have not been safely verified. Keep the original file and review output before using it for important work.</p>
          <h2>Advertising Policy</h2>
          <p>Advertising may be used to support operating costs. Ads should not block the main tool workflow. When advertising is disabled, empty ad containers are not rendered.</p>
          <h2>What Is Not Guaranteed</h2>
          <p>Toolbox is not a professional or certified service. It does not guarantee every file conversion will succeed, every output will work in every program, calculations will have legal force, or performance will be the same across browsers. Keep original files before editing.</p>
        </>
      )
    }
  </article>
</Layout>
