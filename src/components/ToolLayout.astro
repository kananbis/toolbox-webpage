---
import Layout from "./Layout.astro";
import FAQ from "./FAQ.astro";
import RelatedTools from "./RelatedTools.astro";
import AdSlot from "./AdSlot.astro";
import ToolRunner from "./ToolRunner.astro";
import { getFaqOverride, getToolDeepDive, getToolEnhancement } from "@/i18n/content-quality";
import { getRelatedTools, getTool, getToolBasis, i18n, type Lang, type ToolSlug } from "@/i18n/translations";

type Props = {
  tool: {
    slug: ToolSlug;
    name: string;
    description: string;
    seoTitle?: string;
    intro: string;
    usage: string[];
    examples: string[];
    basis?: string;
    faq: { question: string; answer: string }[];
    path: string;
    privacy?: boolean;
  };
  lang: Lang;
};

const { tool, lang } = Astro.props;
const t = i18n[lang];
const title = tool.seoTitle ?? `${tool.name} - ${tool.description}`;
const related = getRelatedTools(lang, tool.slug);
const enhancement = getToolEnhancement(lang, tool.slug);
const deepDive = getToolDeepDive(lang, tool.slug);
const workflowLinkText: Partial<Record<ToolSlug, { target: ToolSlug; before: string; after: string }>> = lang === "ko"
  ? {
      "image-compressor": { target: "image-resizer", before: "원본 해상도가 지나치게 크다면 먼저 ", after: "로 필요한 픽셀 크기를 맞춘 뒤 압축하는 편이 효율적입니다." },
      "image-resizer": { target: "image-compressor", before: "해상도는 유지하고 파일 크기만 줄이려면 ", after: "를 사용하세요." },
      "image-format-converter": { target: "image-compressor", before: "형식 변경보다 파일 크기 감소가 목적이라면 ", after: " 결과도 함께 비교하세요." },
      "image-watermark": { target: "remove-image-metadata", before: "공유 전에 위치 정보도 제거하려면 ", after: "를 함께 사용할 수 있습니다." },
      "remove-image-metadata": { target: "image-watermark", before: "출처 표기가 필요하면 메타데이터를 정리한 뒤 ", after: "로 텍스트 워터마크를 추가할 수 있습니다." },
    }
  : {
      "image-compressor": { target: "image-resizer", before: "When the original dimensions are much larger than needed, use the ", after: " first, then compress the result." },
      "image-resizer": { target: "image-compressor", before: "To keep the same dimensions and reduce only file size, use the ", after: "." },
      "image-format-converter": { target: "image-compressor", before: "If smaller file size is the only goal, also compare the ", after: "." },
      "image-watermark": { target: "remove-image-metadata", before: "To remove location information before sharing, you can also use the ", after: "." },
      "remove-image-metadata": { target: "image-watermark", before: "When an image also needs a visible source mark, add a text watermark with the ", after: " after metadata cleanup." },
    };
const workflowLink = workflowLinkText[tool.slug];
const workflowTarget = workflowLink ? getTool(lang, workflowLink.target) : undefined;
const faqItems = getFaqOverride(lang, tool.slug) ?? tool.faq;
const otherLang = lang === "ko" ? "en" : "ko";
const basis = tool.basis ?? getToolBasis(lang, tool.slug) ?? t.common.basisText;
const formattedBasis = basis.replace(/\. /g, ".\n");
const faqSchema = faqItems.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    }
  : undefined;
const isImageTool = ["image-resizer", "image-compressor", "webp-converter", "image-cropper", "image-rotate-flip", "image-format-converter", "image-mosaic", "image-watermark", "remove-image-metadata", "image-color-picker", "image-color-replacer", "make-color-transparent", "image-to-ascii-art", "image-to-pixel-art"].includes(tool.slug);
const isAudioTool = ["audio-converter", "audio-cutter", "audio-compressor", "audio-volume-editor", "iphone-ringtone-maker", "audio-merger"].includes(tool.slug);
const isPdfTool = ["pdf-merger", "pdf-splitter", "pdf-page-extractor", "image-to-pdf", "pdf-rotate", "pdf-page-delete", "pdf-to-jpg", "pdf-watermark", "pdf-page-numbers", "pdf-organizer"].includes(tool.slug);
const privacyNote = isImageTool
  ? t.common.imagePrivacyNote
  : isAudioTool
    ? lang === "ko"
      ? "선택한 오디오 파일은 서버로 업로드되지 않으며, 현재 브라우저 안에서만 처리됩니다."
      : "Selected audio files are not uploaded to a server and are processed only in your browser."
    : isPdfTool
      ? lang === "ko"
        ? "선택한 파일은 서버로 업로드되지 않으며, 현재 브라우저 안에서만 처리됩니다."
        : "Selected files are not uploaded to a server and are processed only in your browser."
      : t.common.privacyNote;
const aspectRatioReference = lang === "ko"
  ? {
      title: "자주 쓰는 SNS 이미지 비율 참고",
      note: "SNS와 서비스의 권장 이미지 크기는 변경될 수 있습니다. 아래 표는 자르기 비율을 빠르게 고르기 위한 참고용이며, 정확한 업로드 기준은 각 서비스의 최신 안내를 확인하세요.",
      platform: "플랫폼",
      use: "용도",
      ratio: "비율",
      size: "예시 크기",
      rows: [
        ["인스타그램", "정사각형 피드", "1:1", "1080×1080"],
        ["인스타그램", "세로형 피드", "4:5", "1080×1350"],
        ["인스타그램", "가로형 피드", "1.91:1", "1080×566"],
        ["인스타그램", "스토리 / 릴스", "9:16", "1080×1920"],
        ["인스타그램", "프로필", "1:1", "320×320"],
        ["유튜브", "동영상 썸네일", "16:9", "1280×720"],
        ["유튜브", "채널 아트 배너", "16:9", "안전영역 중앙 1546×423 참고"],
        ["유튜브", "쇼츠", "9:16", "1080×1920"],
        ["유튜브", "프로필", "1:1", "800×800"],
        ["틱톡", "동영상 / 썸네일", "9:16", "1080×1920"],
        ["틱톡", "프로필", "1:1", "200×200"],
        ["틱톡", "PC 배너 광고", "7.5:1", "900×120"],
        ["페이스북", "피드 이미지 가로", "1.91:1", "1200×630"],
        ["페이스북", "피드 이미지 정사각", "1:1", "1200×1200"],
        ["페이스북", "스토리", "9:16", "1080×1920"],
        ["페이스북", "커버 사진", "약 2.63:1", "820×312"],
        ["페이스북", "프로필", "1:1", "170×170"],
        ["트위터(X)", "인스트림 이미지", "16:9", "1600×900"],
        ["트위터(X)", "링크 카드", "1.91:1", "1200×628"],
        ["트위터(X)", "헤더 배너", "3:1", "1500×500"],
        ["트위터(X)", "프로필", "1:1", "400×400"],
        ["링크드인", "개인 배너", "4:1", "1584×396"],
        ["링크드인", "회사 페이지 배너", "약 6:1", "1128×191"],
        ["링크드인", "공유 게시물 이미지", "1.91:1", "1200×627"],
        ["링크드인", "프로필", "1:1", "400×400"],
        ["핀터레스트", "표준 핀", "2:3", "1000×1500"],
        ["핀터레스트", "정사각 핀", "1:1", "1000×1000"],
        ["핀터레스트", "아이디어 핀 / 스토리", "9:16", "1080×1920"],
        ["핀터레스트", "프로필", "1:1", "165×165"],
      ],
    }
  : {
      title: "Common Social Media Image Ratios",
      note: "Recommended sizes can change by platform. Use this table as a quick reference for choosing an aspect ratio, and check each service's latest guidance for exact upload requirements.",
      platform: "Platform",
      use: "Use",
      ratio: "Ratio",
      size: "Example size",
      rows: [
        ["Instagram", "Square feed", "1:1", "1080×1080"],
        ["Instagram", "Portrait feed", "4:5", "1080×1350"],
        ["Instagram", "Landscape feed", "1.91:1", "1080×566"],
        ["Instagram", "Stories / Reels", "9:16", "1080×1920"],
        ["Instagram", "Profile", "1:1", "320×320"],
        ["YouTube", "Video thumbnail", "16:9", "1280×720"],
        ["YouTube", "Channel art banner", "16:9", "Central safe area 1546×423"],
        ["YouTube", "Shorts", "9:16", "1080×1920"],
        ["YouTube", "Profile", "1:1", "800×800"],
        ["TikTok", "Video / thumbnail", "9:16", "1080×1920"],
        ["TikTok", "Profile", "1:1", "200×200"],
        ["TikTok", "PC banner ad", "7.5:1", "900×120"],
        ["Facebook", "Landscape feed image", "1.91:1", "1200×630"],
        ["Facebook", "Square feed image", "1:1", "1200×1200"],
        ["Facebook", "Story", "9:16", "1080×1920"],
        ["Facebook", "Cover photo", "About 2.63:1", "820×312"],
        ["Facebook", "Profile", "1:1", "170×170"],
        ["X / Twitter", "In-stream image", "16:9", "1600×900"],
        ["X / Twitter", "Link card", "1.91:1", "1200×628"],
        ["X / Twitter", "Header banner", "3:1", "1500×500"],
        ["X / Twitter", "Profile", "1:1", "400×400"],
        ["LinkedIn", "Personal banner", "4:1", "1584×396"],
        ["LinkedIn", "Company page banner", "About 6:1", "1128×191"],
        ["LinkedIn", "Shared post image", "1.91:1", "1200×627"],
        ["LinkedIn", "Profile", "1:1", "400×400"],
        ["Pinterest", "Standard pin", "2:3", "1000×1500"],
        ["Pinterest", "Square pin", "1:1", "1000×1000"],
        ["Pinterest", "Idea pin / story", "9:16", "1080×1920"],
        ["Pinterest", "Profile", "1:1", "165×165"],
      ],
  };
const imageConverterSupport = lang === "ko"
  ? {
      title: "지원 형식",
      headers: ["형식", "입력", "출력", "비고"],
      rows: [
        ["JPG/JPEG/JFIF", "지원", "지원", "손실 압축, 투명도 없음"],
        ["PNG", "지원", "지원", "투명도 유지 가능"],
        ["APNG", "입력 지원", "PNG ZIP", "애니메이션 PNG 전체 프레임을 PNG ZIP으로 추출"],
        ["WebP", "브라우저 지원 시", "브라우저 지원 시", "정지 WebP 기준. 애니메이션 WebP 전체 프레임 추출은 아직 미지원"],
        ["AVIF", "브라우저 지원 시", "지원", "브라우저 미지원 시 외부 AVIF 인코더 지연 로드"],
        ["GIF", "프레임 선택 / 전체 프레임 ZIP", "PNG ZIP", "정지 출력은 선택 프레임, PNG ZIP은 전체 프레임 추출"],
        ["BMP", "브라우저 지원 시", "지원", "24비트 BMP로 저장"],
        ["SVG", "래스터 입력", "미지원", "스크립트와 외부 리소스 제거 후 변환"],
        ["ICO", "PNG 기반 입력", "ICO / PNG ZIP", "다중 크기 ICO 생성, 포함된 PNG 크기 ZIP 추출"],
        ["HEIC/HEIF", "입력 지원", "미지원", "필요 시 외부 CDN HEIC 코덱 지연 로드"],
        ["TIFF/TIF", "입력 지원", "PNG ZIP", "페이지 선택 변환 또는 전체 페이지 PNG ZIP"],
      ],
    }
  : {
      title: "Supported Formats",
      headers: ["Format", "Input", "Output", "Notes"],
      rows: [
        ["JPG/JPEG/JFIF", "Supported", "Supported", "Lossy compression, no transparency"],
        ["PNG", "Supported", "Supported", "Can preserve transparency"],
        ["APNG", "Input supported", "PNG ZIP", "Extracts animated PNG frames as a PNG ZIP"],
        ["WebP", "When browser supports it", "When browser supports it", "Still WebP only. Animated WebP frame extraction is not supported yet"],
        ["AVIF", "When browser supports it", "Supported", "Lazy-loads the external AVIF encoder when native output is unavailable"],
        ["GIF", "Frame selection / frame ZIP", "PNG ZIP", "Still output uses the selected frame; PNG ZIP extracts all frames"],
        ["BMP", "When browser supports it", "Supported", "Saved as 24-bit BMP"],
        ["SVG", "Raster input", "Not supported", "Scripts and external resources are removed before conversion"],
        ["ICO", "PNG-based input", "ICO / PNG ZIP", "Creates multi-size ICO and extracts embedded PNG sizes as ZIP"],
        ["HEIC/HEIF", "Input supported", "Not supported", "Lazy-loads the external HEIC codec when needed"],
        ["TIFF/TIF", "Input supported", "PNG ZIP", "Selected-page conversion or all pages as PNG ZIP"],
      ],
    };
---

<Layout
  title={title}
  description={tool.description}
  canonical={tool.path}
  lang={lang}
  alternates={[
    { lang: otherLang, href: `/${otherLang}/tools/${tool.slug}` },
    { lang: "x-default", href: `/ko/tools/${tool.slug}` },
  ]}
>
  <article>
    <p class="text-sm font-semibold text-brand">{t.common.freeTool}</p>
    <h1 class="mt-2 text-3xl font-bold tracking-normal md:text-4xl">{tool.name}</h1>
    <p class="page-intro mt-4 text-lg leading-8 text-slate-700">{tool.intro}</p>

    <section class="mt-8">
      <ToolRunner slug={tool.slug} lang={lang} />
      {tool.privacy && <p class="mt-3 text-sm text-slate-600">{privacyNote}</p>}
    </section>

    <section class="prose-lite">
      {
        enhancement && (
          <>
            {enhancement.situations && (
              <>
                <h2>{enhancement.situations.title}</h2>
                {enhancement.situations.body && <p>{enhancement.situations.body}</p>}
                {enhancement.situations.items && (
                  <ul class="mt-3 list-disc space-y-2 pl-6">
                    {enhancement.situations.items.map((item) => <li>{item}</li>)}
                  </ul>
                )}
              </>
            )}
            {enhancement.options && (
              <>
                <h2>{enhancement.options.title}</h2>
                {enhancement.options.body && <p>{enhancement.options.body}</p>}
                {enhancement.options.items && (
                  <ul class="mt-3 list-disc space-y-2 pl-6">
                    {enhancement.options.items.map((item) => <li>{item}</li>)}
                  </ul>
                )}
              </>
            )}
          </>
        )
      }

      <h2>{t.common.usage}</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-6">
        {tool.usage.map((item) => <li>{item}</li>)}
      </ol>

      {
        tool.slug === "image-format-converter" && (
          <>
            <h2>{imageConverterSupport.title}</h2>
            <div class="mt-4 overflow-x-auto rounded-lg border border-line">
              <table class="min-w-[720px] w-full border-collapse text-left text-sm">
                <thead class="bg-slate-50 text-slate-700">
                  <tr>
                    {imageConverterSupport.headers.map((header) => (
                      <th class="border-b border-line px-3 py-2">{header}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {imageConverterSupport.rows.map((row) => (
                    <tr>
                      <td class="border-t border-line px-3 py-2 font-medium text-ink">{row[0]}</td>
                      <td class="border-t border-line px-3 py-2">{row[1]}</td>
                      <td class="border-t border-line px-3 py-2">{row[2]}</td>
                      <td class="border-t border-line px-3 py-2">{row[3]}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )
      }

      <h2>{t.common.examples}</h2>
      <ul class="mt-3 list-disc space-y-2 pl-6">
        {tool.examples.map((item) => <li>{item}</li>)}
      </ul>

      {
        deepDive && (
          <>
            <h2>{deepDive.title}</h2>
            {deepDive.intro && <p>{deepDive.intro}</p>}
            <div class="mt-4 overflow-x-auto rounded-lg border border-line">
              <table class="min-w-[520px] w-full border-collapse text-left text-sm">
                <thead class="bg-slate-50 text-slate-700">
                  <tr>
                    {deepDive.headers.map((header) => <th class="border-b border-line px-3 py-2">{header}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {deepDive.rows.map((row) => (
                    <tr>
                      <td class="border-t border-line px-3 py-2 font-medium text-ink">{row[0]}</td>
                      <td class="border-t border-line px-3 py-2">{row[1]}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {deepDive.note && <p class="mt-3 text-slate-700">{deepDive.note}</p>}
            {workflowLink && workflowTarget && (
              <p class="mt-3 text-slate-700">{workflowLink.before}<a href={workflowTarget.path}>{workflowTarget.name}</a>{workflowLink.after}</p>
            )}
          </>
        )
      }

      {
        tool.slug === "image-cropper" && (
          <>
            <h2>{aspectRatioReference.title}</h2>
            <p>{aspectRatioReference.note}</p>
            <div class="mt-4 overflow-x-auto rounded-lg border border-line">
              <table class="min-w-[720px] w-full border-collapse text-left text-sm">
                <thead class="bg-slate-50 text-slate-700">
                  <tr>
                    <th class="border-b border-line px-3 py-2">{aspectRatioReference.platform}</th>
                    <th class="border-b border-line px-3 py-2">{aspectRatioReference.use}</th>
                    <th class="border-b border-line px-3 py-2">{aspectRatioReference.ratio}</th>
                    <th class="border-b border-line px-3 py-2">{aspectRatioReference.size}</th>
                  </tr>
                </thead>
                <tbody>
                  {aspectRatioReference.rows.map((row) => (
                    <tr>
                      <td class="border-t border-line px-3 py-2 font-medium text-ink">{row[0]}</td>
                      <td class="border-t border-line px-3 py-2">{row[1]}</td>
                      <td class="border-t border-line px-3 py-2 font-semibold">{row[2]}</td>
                      <td class="border-t border-line px-3 py-2">{row[3]}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )
      }

      <h2>{t.common.basis}</h2>
      <p class="whitespace-pre-line">{formattedBasis}</p>

      {
        enhancement && (
          <>
            {enhancement.interpretation && (
              <>
                <h2>{enhancement.interpretation.title}</h2>
                {enhancement.interpretation.body && <p>{enhancement.interpretation.body}</p>}
                {enhancement.interpretation.items && (
                  <ul class="mt-3 list-disc space-y-2 pl-6">
                    {enhancement.interpretation.items.map((item) => <li>{item}</li>)}
                  </ul>
                )}
              </>
            )}
            {enhancement.limitations && (
              <>
                <h2>{enhancement.limitations.title}</h2>
                {enhancement.limitations.body && <p>{enhancement.limitations.body}</p>}
                {enhancement.limitations.items && (
                  <ul class="mt-3 list-disc space-y-2 pl-6">
                    {enhancement.limitations.items.map((item) => <li>{item}</li>)}
                  </ul>
                )}
              </>
            )}
            {enhancement.troubleshooting && (
              <>
                <h2>{enhancement.troubleshooting.title}</h2>
                {enhancement.troubleshooting.body && <p>{enhancement.troubleshooting.body}</p>}
                {enhancement.troubleshooting.items && (
                  <ul class="mt-3 list-disc space-y-2 pl-6">
                    {enhancement.troubleshooting.items.map((item) => <li>{item}</li>)}
                  </ul>
                )}
              </>
            )}
          </>
        )
      }
    </section>

    {enhancement && <AdSlot lang={lang} placement="toolBottom" />}

    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {faqItems.length > 0 && <FAQ items={faqItems} />}
    <RelatedTools tools={related} lang={lang} />
  </article>
</Layout>
