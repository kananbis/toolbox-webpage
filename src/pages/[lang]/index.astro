---
import Layout from "@/components/Layout.astro";
import AdSlot from "@/components/AdSlot.astro";
import BookmarkPrompt from "@/components/BookmarkPrompt.astro";
import ToolCard from "@/components/ToolCard.astro";
import { getSiteUpdates } from "@/data/site-updates";
import { getCategoryItems, getTools, i18n, languages, type Lang } from "@/i18n/translations";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = i18n[lang];
const tools = getTools(lang);
const featuredSlugs = [
  "audio-compressor",
  "audio-cutter",
  "image-color-picker",
  "iphone-ringtone-maker",
  "pdf-merger",
  "image-resizer",
  "image-compressor",
  "pdf-to-jpg",
];
const frequentSlugs = [
  "audio-compressor",
  "audio-cutter",
  "iphone-ringtone-maker",
  "pdf-merger",
  "image-resizer",
];
const featured = featuredSlugs.map((slug) => tools.find((tool) => tool.slug === slug)).filter(Boolean);
const frequent = frequentSlugs.map((slug) => tools.find((tool) => tool.slug === slug)).filter(Boolean);
const categories = getCategoryItems(lang);
const recentUpdates = getSiteUpdates(lang).slice(0, 4);
const otherLang = lang === "ko" ? "en" : "ko";
const caseConverterLabel = lang === "ko" ? "\uC601\uBB38 \uB300\uC18C\uBB38\uC790 \uBCC0\uD658\uAE30" : null;
const withSlash = (path: string) => (path.endsWith("/") ? path : `${path}/`);
---

<Layout
  title={t.home.title}
  description={t.home.description}
  canonical={`/${lang}`}
  lang={lang}
  alternates={[
    { lang: otherLang, href: `/${otherLang}` },
    { lang: "x-default", href: "/ko" },
  ]}
>
  <section class="grid gap-8 md:grid-cols-[minmax(0,1fr)_340px] md:items-center md:gap-12 lg:gap-14">
    <div>
      <p class="text-sm font-semibold text-brand">{t.home.label}</p>
      <h1 class="mt-3 text-4xl font-bold tracking-normal md:text-5xl">{t.home.h1}</h1>
      <p class="mt-5 text-lg leading-8 text-slate-700">{t.home.body1}</p>
      <p class="mt-4 text-base leading-7 text-slate-700">{t.home.body2}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`/${lang}/tools/`} class="rounded-md bg-brand px-5 py-3 text-sm font-semibold text-white no-underline">{t.home.button}</a>
      </div>
    </div>
    <div class="w-full rounded-lg border border-line bg-panel p-5 md:max-w-[340px] md:justify-self-end">
      <h2 class="text-lg font-bold">{t.home.frequent}</h2>
      <div class="mt-4 grid gap-3">
        {frequent.map((tool) => (
          <a href={withSlash(tool.path)} class="rounded-md bg-white p-3 text-sm font-semibold text-ink no-underline shadow-sm">
            {tool.slug === "case-converter" && caseConverterLabel ? caseConverterLabel : tool.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <BookmarkPrompt lang={lang} />

  <AdSlot lang={lang} placement="homeMiddle" />

  <section class="mt-12">
    <h2 class="text-2xl font-bold">{t.home.categories}</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-5">
      {categories.map((category) => (
        <a href={withSlash(category.path)} class="rounded-lg border border-line bg-white p-4 text-ink no-underline shadow-sm">
          <p class="font-semibold">{category.name}</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">{category.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-12 border-y border-line py-8">
    <h2 class="text-2xl font-bold">{lang === "ko" ? "이 사이트를 만드는 방식" : "How This Site Is Built"}</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <div>
        <h3 class="font-semibold text-ink">{lang === "ko" ? "브라우저에서 처리" : "Browser-first processing"}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-700">{lang === "ko" ? "가능한 파일과 입력값은 서버 업로드 없이 현재 브라우저에서 처리합니다." : "Where possible, files and input are handled in the current browser without a server upload workflow."}</p>
      </div>
      <div>
        <h3 class="font-semibold text-ink">{lang === "ko" ? "기능과 제한을 함께 표시" : "Features with their limits"}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-700">{lang === "ko" ? "파일 형식, 브라우저, 기기 메모리에 따라 달라지는 제한을 도구별로 안내합니다." : "Each tool explains limits that depend on file type, browser support, and device memory."}</p>
      </div>
      <div>
        <h3 class="font-semibold text-ink">{lang === "ko" ? "결과 확인을 우선" : "Preview before download"}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-700">{lang === "ko" ? "이미지와 오디오 도구는 가능한 경우 미리보기와 결과 정보를 보여 준 뒤 다운로드합니다." : "Image and audio tools show previews and result details when possible before download."}</p>
      </div>
    </div>
  </section>

  <section class="mt-12">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold">{lang === "ko" ? "최근 업데이트" : "Recent Updates"}</h2>
        <p class="mt-2 text-slate-600">{lang === "ko" ? "실제로 배포한 기능과 검증한 변경 사항을 기록합니다." : "A record of deployed features and verified changes."}</p>
      </div>
      <a class="text-sm font-semibold" href={`/${lang}/updates/`}>{lang === "ko" ? "전체 업데이트" : "All updates"}</a>
    </div>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {recentUpdates.map((update) => (
        <article class="rounded-lg border border-line bg-white p-4">
          <p class="text-xs font-semibold text-brand">{update.date}</p>
          <h3 class="mt-2 font-semibold text-ink">{update.title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-700">{update.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-bold">{t.home.featured}</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-4">
      {featured.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>
</Layout>
