---
import Layout from "@/components/Layout.astro";
import ToolCard from "@/components/ToolCard.astro";
import ToolLayout from "@/components/ToolLayout.astro";
import { getCategoryEnhancement } from "@/i18n/content-quality";
import { baseTools, categorySlugs, getCategoryItems, getToolsByCategory, getTool, languages, i18n, type CategorySlug, type Lang } from "@/i18n/translations";

export function getStaticPaths() {
  return languages.flatMap((lang) => [
    ...categorySlugs.map((category) => ({ params: { lang, id: category }, props: { kind: "category", lang, id: category } })),
    ...baseTools.map((tool) => ({ params: { lang, id: tool.slug }, props: { kind: "tool", lang, id: tool.slug } })),
  ]);
}

const { kind, id } = Astro.props;
const lang = Astro.props.lang as Lang;
const t = i18n[lang];
const category = kind === "category" ? getCategoryItems(lang).find((item) => item.slug === id) : undefined;
const tool = kind === "tool" ? getTool(lang, id) : undefined;
const categoryEnhancement = category ? getCategoryEnhancement(lang, category.slug as CategorySlug) : undefined;
const otherLang = lang === "ko" ? "en" : "ko";
const imageDecisionGuide = lang === "ko"
  ? {
      title: "목적에 맞는 이미지 도구",
      headers: ["목적", "추천 도구", "알아둘 점"],
      rows: [
        ["파일 용량 줄이기", "이미지 압축", "픽셀 크기는 유지하고 저장 품질 또는 형식을 조절"],
        ["가로·세로 크기 변경", "이미지 리사이즈", "필요한 크기로 줄인 뒤 압축하면 용량을 더 줄일 수 있음"],
        ["특정 영역만 남기기", "이미지 자르기", "잘라서 채우기 또는 원본 전체 유지 선택"],
        ["사진 기울기·방향 수정", "이미지 회전뒤집기", "자유 회전은 결과 캔버스가 커질 수 있음"],
        ["파일 형식 바꾸기", "이미지 포맷 변환기", "투명도와 호환성 조건을 먼저 확인"],
        ["사진 위치·촬영 정보 정리", "EXIF·메타데이터 편집기", "GPS만 제거하거나 지원되는 항목을 수정"],
        ["얼굴·번호판 가리기", "이미지 모자이크", "사각형, 원형, 브러시 영역 선택"],
        ["출처·저작권 표시", "이미지 워터마크", "한 곳 또는 반복 배치 사용"],
      ],
      workflowTitle: "웹·SNS 업로드 전 작업 순서",
      workflow: "크기 조정이 필요하면 먼저 리사이즈하고, 구도가 달라져야 하면 자르기를 적용합니다. 필요한 경우 워터마크나 메타데이터 정리를 한 뒤 마지막에 압축하거나 형식을 변환하세요.",
    }
  : {
      title: "Choose an Image Tool by Task",
      headers: ["Goal", "Recommended tool", "What to know"],
      rows: [
        ["Reduce file size", "Image Compressor", "Keep dimensions and adjust storage quality or format"],
        ["Change width and height", "Image Resizer", "Resize first, then compress when a smaller file is needed"],
        ["Keep only part of an image", "Image Cropper", "Choose Crop to fill or Keep full image"],
        ["Fix photo angle or direction", "Rotate and Flip Image", "Free rotation can increase the output canvas"],
        ["Change file format", "Image Format Converter", "Check transparency and compatibility first"],
        ["Remove photo location or capture data", "EXIF & Metadata Editor", "Remove GPS only or edit supported fields"],
        ["Hide faces or numbers", "Image Mosaic", "Choose rectangular, circular, or brush areas"],
        ["Add source or copyright text", "Image Watermark", "Use single or repeated placement"],
      ],
      workflowTitle: "Suggested Web and Social Upload Workflow",
      workflow: "Resize first when dimensions need to change, then crop when the composition needs to change. Add a watermark or clean metadata if needed, then compress or convert format as the final step.",
    };
---

{tool ? (
  <ToolLayout tool={tool} lang={lang} />
) : category ? (
  <Layout
    title={`${category.name} - ${t.siteName}`}
    description={category.description}
    canonical={`/${lang}/tools/${category.slug}`}
    lang={lang}
    alternates={[
      { lang: otherLang, href: `/${otherLang}/tools/${category.slug}` },
      { lang: "x-default", href: `/ko/tools/${category.slug}` },
    ]}
  >
    <h1 class="text-3xl font-bold tracking-normal md:text-4xl">{category.name}</h1>
    <p class="page-intro mt-4 text-lg leading-8 text-slate-700">{category.description}</p>
    {
      categoryEnhancement && (
        <section class="prose-lite mt-8">
          {categoryEnhancement.guide.map((section) => (
            <>
              <h2>{section.title}</h2>
              {section.body && <p>{section.body}</p>}
              {section.items && (
                <ul class="mt-3 list-disc space-y-2 pl-6">
                  {section.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </>
          ))}
        </section>
      )
    }
    {
      category?.slug === "image" && (
        <section class="prose-lite mt-8">
          <h2>{imageDecisionGuide.title}</h2>
          <div class="mt-4 overflow-x-auto rounded-lg border border-line">
            <table class="min-w-[680px] w-full border-collapse text-left text-sm">
              <thead class="bg-slate-50 text-slate-700">
                <tr>{imageDecisionGuide.headers.map((header) => <th class="border-b border-line px-3 py-2">{header}</th>)}</tr>
              </thead>
              <tbody>
                {imageDecisionGuide.rows.map((row) => (
                  <tr>
                    <td class="border-t border-line px-3 py-2 font-medium text-ink">{row[0]}</td>
                    <td class="border-t border-line px-3 py-2">{row[1]}</td>
                    <td class="border-t border-line px-3 py-2">{row[2]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <h2>{imageDecisionGuide.workflowTitle}</h2>
          <p>{imageDecisionGuide.workflow}</p>
        </section>
      )
    }
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {getToolsByCategory(lang, category.slug as CategorySlug).map((item) => <ToolCard tool={item} />)}
    </div>
  </Layout>
) : null}
