---
import Layout from "@/components/Layout.astro";
import { i18n, languages, type Lang } from "@/i18n/translations";
import { SITE_CONFIG } from "../../../site.config.mjs";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = i18n[lang];
const otherLang = lang === "ko" ? "en" : "ko";
const contactEmail = SITE_CONFIG.contactEmail;
const title = lang === "ko" ? `문의 - ${t.siteName}` : `Contact - ${t.siteName}`;
const description =
  lang === "ko"
    ? "Toolbox 오류 신고, 기능 제안, 지원 형식 문의, 개인정보 및 광고 관련 문의 방법을 안내합니다."
    : "Contact Toolbox for bug reports, feature suggestions, supported format questions, privacy questions, and advertising inquiries.";
---

<Layout
  title={title}
  description={description}
  canonical={`/${lang}/contact`}
  lang={lang}
  alternates={[{ lang: otherLang, href: `/${otherLang}/contact` }, { lang: "x-default", href: "/ko/contact" }]}
>
  <article class="prose-lite max-w-3xl">
    <h1 class="text-3xl font-bold">{lang === "ko" ? "문의" : "Contact"}</h1>
    {
      lang === "ko" ? (
        <>
          <p class="mt-4">오류 신고, 기능 제안, 지원 형식 문의, 개인정보 문의, 광고 관련 문의가 있다면 아래 정보를 참고해 연락해 주세요.</p>
          <h2>오류 신고에 포함하면 좋은 정보</h2>
          <ul>
            <li>사용한 도구 이름과 페이지 주소</li>
            <li>브라우저와 버전</li>
            <li>운영체제 또는 기기 종류</li>
            <li>입력 파일 형식과 대략적인 파일 크기</li>
            <li>표시된 오류 메시지</li>
            <li>문제가 다시 발생하는 순서</li>
          </ul>
          <h2>문의할 수 있는 내용</h2>
          <p>도구가 동작하지 않는 문제, 새 도구 제안, 지원 형식 추가 요청, 개인정보 처리 관련 질문, 광고 표시와 관련된 의견을 보낼 수 있습니다.</p>
          <h2>연락 방법</h2>
          {contactEmail ? (
            <p class="rounded-lg border border-line bg-panel p-4">
              <span class="font-semibold">이메일: </span>
              <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
            </p>
          ) : (
            <p class="rounded-lg border border-line bg-panel p-4">현재 배포 환경에 문의 이메일이 설정되어 있지 않습니다. 운영자는 `PUBLIC_CONTACT_EMAIL` 환경 변수를 설정해야 이 페이지에 실제 연락처가 표시됩니다.</p>
          )}
          <p>문의 폼은 제공하지 않습니다. 작동하지 않는 폼이나 임시 버튼 대신 실제 연락 가능한 이메일만 표시합니다.</p>
        </>
      ) : (
        <>
          <p class="mt-4">Use this page for bug reports, feature suggestions, supported format questions, privacy questions, and advertising-related feedback.</p>
          <h2>Helpful Details for Bug Reports</h2>
          <ul>
            <li>The tool name and page URL</li>
            <li>Your browser and version</li>
            <li>Your operating system or device</li>
            <li>The input file format and approximate file size</li>
            <li>The error message shown on the page</li>
            <li>The steps needed to reproduce the issue</li>
          </ul>
          <h2>What You Can Ask About</h2>
          <p>You can report broken tools, suggest new utilities, ask about supported file formats, raise privacy questions, or send feedback about advertising placement.</p>
          <h2>Contact Method</h2>
          {contactEmail ? (
            <p class="rounded-lg border border-line bg-panel p-4">
              <span class="font-semibold">Email: </span>
              <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
            </p>
          ) : (
            <p class="rounded-lg border border-line bg-panel p-4">No contact email is configured in the current deployment. The site operator should set the `PUBLIC_CONTACT_EMAIL` environment variable before review.</p>
          )}
          <p>This page does not provide a contact form. It only shows a real email address when one is configured.</p>
        </>
      )
    }
  </article>
</Layout>
