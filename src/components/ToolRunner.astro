        const formatLabel = (type) => ({
          "image/jpeg": "JPG",
          "image/png": "PNG",
          "image/webp": "WebP",
          "image/avif": "AVIF",
          "image/gif": "GIF",
          "image/bmp": "BMP",
          "image/svg+xml": "SVG",
          "image/heic": "HEIC",
          "image/heif": "HEIF",
          "image/tiff": "TIFF",
          "image/x-icon": "ICO",
        })[type] || type || "Unknown";
        const formatBytes = (bytes) => {
          if (!Number.isFinite(bytes)) return "-";
          if (bytes < 1024) return `${bytes} B`;
          if (bytes < 1024 ** 2) return `${(bytes / 1024).toFixed(2)} KB`;
          if (bytes < 1024 ** 3) return `${(bytes / 1024 ** 2).toFixed(2)} MB`;
          return `${(bytes / 1024 ** 3).toFixed(2)} GB`;
        };
        const bytesToAscii = (bytes) => Array.from(bytes, (byte) => byte >= 32 && byte <= 126 ? String.fromCharCode(byte) : "\0").join("");
